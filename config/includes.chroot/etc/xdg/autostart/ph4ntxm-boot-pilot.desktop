[Desktop Entry]
Type=Application
Name=PH4NTXM Boot Pilot
Comment=Establish network connectivity and verify boot protection gates
Exec=/usr/bin/python3 /usr/local/bin/ph4ntxm-boot-pilot
Icon=ph4ntxm-boot-pilot
Terminal=false
OnlyShowIn=XFCE;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
StartupNotify=false
