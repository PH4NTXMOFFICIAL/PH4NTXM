    <Menu>
        <Name>PH4NTXM OpSec Suite</Name>
        <Directory>ph4ntxm-opsec-suite.directory</Directory>

        <Include>
            <Category>X-PH4NTXMOpSecSuite</Category>
        </Include>
    </Menu>

    <Menu>
        <Name>Pentesting</Name>
        <Directory>pentesting.directory</Directory>

        <Include>
            <Category>X-PentestingPH4NTXM</Category>
        </Include>
    </Menu>

    <Menu>
        <Name>Security</Name>
        <Directory>security.directory</Directory>

        <Include>
            <Category>X-SecurityPH4NTXM</Category>
        </Include>
    </Menu>

    <Menu>
        <Name>Anonymity</Name>
        <Directory>anonymity.directory</Directory>

        <Include>
            <Category>X-AnonymityPH4NTXM</Category>
        </Include>
    </Menu>
