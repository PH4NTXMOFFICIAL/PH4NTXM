[Unit]
Description=PH4NTXM Dead Man's Switch

[Service]
Type=notify
User=root
Group=root
ExecStart=/usr/local/sbin/ph4ntxm-dead-man-switch-control daemon
Restart=always
RestartSec=1
WatchdogSec=5s
WatchdogSignal=SIGKILL
NotifyAccess=main
TimeoutStartSec=30s
RuntimeDirectory=ph4ntxm-dead-man-switch
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/run/ph4ntxm-dead-man-switch
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
