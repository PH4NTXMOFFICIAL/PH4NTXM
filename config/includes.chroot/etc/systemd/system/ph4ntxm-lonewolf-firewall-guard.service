[Unit]
Description=PH4NTXM Lone Wolf Firewall Guardian
After=ph4ntxm-lonewolf.service
Requires=ph4ntxm-lonewolf.service
ConditionPathExists=/run/ph4ntxm/mode-lonewolf

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/lib/ph4ntxm/lonewolf/ph4ntxm-lonewolf-firewall-guard.sh
Restart=always
RestartSec=1
TimeoutStartSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=ph4ntxm-lonewolf-multi-user.target
