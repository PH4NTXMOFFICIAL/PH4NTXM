[Unit]
Description=PH4NTXM Link-Up Jitter
DefaultDependencies=no
Before=network-pre.target NetworkManager.service
After=ph4ntxm-link-block.service ph4ntxm-dhcp-session-generator.service ph4ntxm-lonewolf-dhcp-session-generator.service
Requires=ph4ntxm-link-block.service ph4ntxm-dhcp-session-generator.service ph4ntxm-lonewolf-dhcp-session-generator.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ph4ntxm-link-jitter.sh

[Install]
WantedBy=network-pre.target
