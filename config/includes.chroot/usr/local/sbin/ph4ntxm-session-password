#!/usr/bin/python3 -I
# Copyright (C) PH4NTXM
# Licensed under the GNU General Public License v3.0.
"""LightDM display gate. The GTK child is unprivileged, only this broker sets passwords."""
import ctypes
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import resource
import stat
import subprocess
import sys
import tempfile

STATE = Path('/run/ph4ntxm-session-auth')
READY = STATE / 'ready'
GUI = '/usr/local/bin/ph4ntxm-session-setup'
SAFE_ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'}
MAX_REQUEST = 4096


def valid_password(value):
    return isinstance(value, str) and 6 <= len(value) <= 256 and not any(
        ord(c) < 32 or ord(c) == 127 for c in value
    )


def request_password(raw):
    if not raw.endswith(b'\n') or len(raw) > MAX_REQUEST:
        raise ValueError('Invalid request')
    request = json.loads(raw.decode('utf-8'))
    if not isinstance(request, dict) or set(request) != {'password', 'confirmation'}:
        raise ValueError('Invalid request')
    password = request['password']
    if not valid_password(password) or password != request['confirmation']:
        raise ValueError('Passwords must match and contain 6 to 256 characters.')
    return password


def set_password(password):
    # Fixed account, no command arguments, temporary files or inherited environment containing secrets.
    try:
        result = subprocess.run(
            ['/usr/sbin/chpasswd'], input=('ph4ntxm:' + password + '\n').encode(),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            env=SAFE_ENV, timeout=15,
        )
        return result.returncode == 0
    except subprocess.TimeoutExpired:
        return False


def conversation(reader, writer):
    while True:
        raw = reader.readline(MAX_REQUEST + 1)
        if not raw:
            return False
        try:
            password = request_password(raw)
        except (ValueError, UnicodeError):
            # Oversized / unterminated frames cannot be resynchronized safely.
            if len(raw) > MAX_REQUEST or not raw.endswith(b'\n'):
                return False
            response = {'ok': False, 'error': 'Enter matching passwords of 6 to 256 characters.'}
        else:
            if set_password(password):
                READY.write_text('ready\n')
                READY.chmod(0o644)
                response = {'ok': True}
            else:
                response = {'ok': False, 'error': 'The password could not be set. Please try again.'}
            password = ''
        raw = b''
        writer.write((json.dumps(response) + '\n').encode())
        writer.flush()
        if response['ok']:
            return True


def activate_display(environment):
    # LightDM has not activated the user's session yet. Select the X server's VT.
    result = subprocess.run(
        ['/usr/bin/xprop', '-root', 'XFree86_VT'], env=environment,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=10, check=True,
    )
    match = re.fullmatch(r'XFree86_VT\(INTEGER\) = ([0-9]+)\s*', result.stdout)
    if not match or not 1 <= int(match[1]) <= 63:
        raise ValueError('No local graphical console')
    subprocess.run(['/usr/bin/chvt', match[1]], env=SAFE_ENV, timeout=10, check=True)


def protected_directory(path):
    info = path.lstat()
    return stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022


def run_setup():
    display = os.environ.get('DISPLAY', '')
    authority = os.environ.get('XAUTHORITY', '')
    if not re.fullmatch(r':[0-9]+(?:\.[0-9]+)?', display) or not authority.startswith('/'):
        return 1
    # LightDM supplies its root-owned X authority. Copy it only to the isolated greeter home.
    with os.fdopen(os.open(authority, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as source:
        info = os.fstat(source.fileno())
        if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_size > 65536:
            return 1
        cookie = source.read(65537)
    account = pwd.getpwnam('lightdm')
    if account.pw_uid == 0:
        return 1
    with tempfile.TemporaryDirectory(prefix='greeter-', dir=STATE) as directory:
        home = Path(directory)
        xauth = home / 'Xauthority'
        xauth.write_bytes(cookie)
        xauth.chmod(0o600)
        os.chown(xauth, account.pw_uid, account.pw_gid)
        os.chown(home, account.pw_uid, account.pw_gid)
        cookie = b''
        environment = dict(SAFE_ENV, DISPLAY=display, XAUTHORITY=str(xauth))
        activate_display(environment)
        environment.update(
            HOME=str(home), XDG_RUNTIME_DIR=str(home), USER='lightdm', LOGNAME='lightdm',
            GDK_BACKEND='x11', NO_AT_BRIDGE='1',
        )
        child = subprocess.Popen(
            ['/usr/bin/setpriv', '--reuid', str(account.pw_uid), '--regid', str(account.pw_gid),
             '--clear-groups', '--no-new-privs', '/usr/bin/python3', '-I', GUI],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=environment, cwd='/',
        )
        try:
            success = conversation(child.stdout, child.stdin)
            if success:
                return 0 if child.wait(timeout=10) == 0 else 1
            return 1
        finally:
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()
            child.stdin.close()
            child.stdout.close()


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        return 1
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    ctypes.CDLL(None).prctl(4, 0, 0, 0, 0)
    os.umask(0o077)
    STATE.mkdir(mode=0o755, exist_ok=True)
    if not protected_directory(STATE):
        return 1
    STATE.chmod(0o755)
    fd = os.open(STATE / 'setup.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if READY.exists():
            return subprocess.run(
                ['/usr/local/sbin/ph4ntxm-session-status', 'auth-ready'], env=SAFE_ENV,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode
        return run_setup()


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        print('PH4NTXM session setup could not complete. Desktop startup remains blocked.', file=sys.stderr)
        raise SystemExit(1)
