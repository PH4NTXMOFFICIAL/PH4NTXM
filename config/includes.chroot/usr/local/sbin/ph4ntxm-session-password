#!/usr/bin/python3 -I
# Copyright (C) PH4NTXM
# Licensed under the GNU General Public License v3.0.

import base64
import ctypes
import fcntl
import json
import os
from pathlib import Path
import pwd
import re
import resource
import stat
import subprocess
import sys
import tempfile

STATE = Path('/run/ph4ntxm-session-auth')
READY = STATE / 'ready'
EMERGENCY = STATE / 'emergency'
GUI = '/usr/local/bin/ph4ntxm-session-setup'
SAFE_ENV = {'PATH': '/usr/sbin:/usr/bin:/sbin:/bin', 'LANG': 'C.UTF-8'}
MAX_REQUEST = 4096
HASH_PATTERN = re.compile(r'\$6\$rounds=100000\$[./0-9A-Za-z]{16}\$[./0-9A-Za-z]{86}')


def valid_password(value):
    if not isinstance(value, str) or not 6 <= len(value) <= 256:
        return False
    try:
        return len(value.encode("utf-8")) <= 511 and not any(
            ord(c) < 32 or ord(c) == 127 for c in value
        )
    except UnicodeError:
        return False


def request_password(raw):
    if not raw.endswith(b"\n") or len(raw) > MAX_REQUEST:
        raise ValueError("Invalid request")
    request = json.loads(raw.decode("utf-8"))
    fields = {"password", "confirmation", "emergency_password", "emergency_confirmation"}
    if not isinstance(request, dict) or set(request) != fields:
        raise ValueError("Invalid request")
    password = request["password"]
    if not valid_password(password) or password != request["confirmation"]:
        raise ValueError("Invalid session password")
    emergency = request["emergency_password"]
    confirmation = request["emergency_confirmation"]
    if emergency == "" and confirmation == "":
        return password, ""
    if not valid_password(emergency) or emergency != confirmation or emergency == password:
        raise ValueError("Invalid emergency password")
    return password, emergency


def emergency_record(password):
    if not password:
        return b"disabled\n"
    salt = base64.b64encode(os.urandom(12)).decode("ascii").replace("+", ".")
    setting = ("$6$rounds=100000$" + salt + "$").encode("ascii")
    library = ctypes.CDLL("libcrypt.so.1", use_errno=True)
    library.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
    library.crypt.restype = ctypes.c_void_p
    buffer = ctypes.create_string_buffer(password.encode("utf-8"))
    try:
        pointer = library.crypt(buffer, setting)
        if not pointer:
            raise ValueError("Password hashing failed")
        encoded = ctypes.string_at(pointer)
        if not encoded.startswith(setting) or not HASH_PATTERN.fullmatch(encoded.decode("ascii")):
            raise ValueError("Password hashing failed")
        return encoded + b"\n"
    finally:
        ctypes.memset(buffer, 0, ctypes.sizeof(buffer))


def publish_record(path, data, mode):
    fd, temporary = tempfile.mkstemp(prefix=".auth-", dir=STATE)
    try:
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(data)
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def configure_passwords(password, emergency):
    record = emergency_record(emergency)
    if not set_password(password):
        return False
    publish_record(EMERGENCY, record, 0o600)
    publish_record(READY, b"ready\n", 0o644)
    return True


def set_password(password):
    try:
        result = subprocess.run(
            ['/usr/sbin/chpasswd'], input=('ph4ntxm:' + password + '\n').encode(),
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            env=SAFE_ENV, timeout=15,
        )
        return result.returncode == 0
    except subprocess.TimeoutExpired:
        return False


def conversation(reader, writer):
    while True:
        raw = reader.readline(MAX_REQUEST + 1)
        if not raw:
            return False
        password = emergency = ""
        try:
            password, emergency = request_password(raw)
        except (ValueError, UnicodeError):
            if len(raw) > MAX_REQUEST or not raw.endswith(b"\n"):
                return False
            response = {
                "ok": False,
                "error": "Enter matching passwords of 6 to 256 characters. The emergency password must differ.",
            }
        else:
            try:
                success = configure_passwords(password, emergency)
            except (OSError, ValueError):
                success = False
            response = {"ok": True} if success else {
                "ok": False,
                "error": "Session passwords could not be configured. Please try again.",
            }
        finally:
            password = emergency = ""
            raw = b""
        writer.write((json.dumps(response) + "\n").encode())
        writer.flush()
        if response["ok"]:
            return True


def activate_display(environment):
    result = subprocess.run(
        ['/usr/bin/xprop', '-root', 'XFree86_VT'], env=environment,
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, timeout=10, check=True,
    )
    match = re.fullmatch(r'XFree86_VT\(INTEGER\) = ([0-9]+)\s*', result.stdout)
    if not match or not 1 <= int(match[1]) <= 63:
        raise ValueError('No local graphical console')
    subprocess.run(['/usr/bin/chvt', match[1]], env=SAFE_ENV, timeout=10, check=True)


def protected_directory(path):
    info = path.lstat()
    return stat.S_ISDIR(info.st_mode) and info.st_uid == 0 and not info.st_mode & 0o022


def run_setup():
    display = os.environ.get('DISPLAY', '')
    authority = os.environ.get('XAUTHORITY', '')
    if not re.fullmatch(r':[0-9]+(?:\.[0-9]+)?', display) or not authority.startswith('/'):
        return 1
    with os.fdopen(os.open(authority, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as source:
        info = os.fstat(source.fileno())
        if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_size > 65536:
            return 1
        cookie = source.read(65537)
    account = pwd.getpwnam('lightdm')
    if account.pw_uid == 0:
        return 1
    with tempfile.TemporaryDirectory(prefix='greeter-', dir=STATE) as directory:
        home = Path(directory)
        xauth = home / 'Xauthority'
        xauth.write_bytes(cookie)
        xauth.chmod(0o600)
        os.chown(xauth, account.pw_uid, account.pw_gid)
        os.chown(home, account.pw_uid, account.pw_gid)
        cookie = b''
        environment = dict(SAFE_ENV, DISPLAY=display, XAUTHORITY=str(xauth))
        activate_display(environment)
        environment.update(
            HOME=str(home), XDG_RUNTIME_DIR=str(home), USER='lightdm', LOGNAME='lightdm',
            GDK_BACKEND='x11', NO_AT_BRIDGE='1',
        )
        child = subprocess.Popen(
            ['/usr/bin/setpriv', '--reuid', str(account.pw_uid), '--regid', str(account.pw_gid),
             '--clear-groups', '--no-new-privs', '/usr/bin/python3', '-I', GUI],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=environment, cwd='/',
        )
        try:
            success = conversation(child.stdout, child.stdin)
            if success:
                return 0 if child.wait(timeout=10) == 0 else 1
            return 1
        finally:
            if child.poll() is None:
                child.terminate()
                try:
                    child.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()
            child.stdin.close()
            child.stdout.close()


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        return 1
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    ctypes.CDLL(None).prctl(4, 0, 0, 0, 0)
    os.umask(0o077)
    STATE.mkdir(mode=0o755, exist_ok=True)
    if not protected_directory(STATE):
        return 1
    STATE.chmod(0o755)
    fd = os.open(STATE / 'setup.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'wb') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if READY.exists():
            return subprocess.run(
                ['/usr/local/sbin/ph4ntxm-session-status', 'auth-ready'], env=SAFE_ENV,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode
        return run_setup()


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        print('PH4NTXM session setup could not complete. Desktop startup remains blocked.', file=sys.stderr)
        raise SystemExit(1)
