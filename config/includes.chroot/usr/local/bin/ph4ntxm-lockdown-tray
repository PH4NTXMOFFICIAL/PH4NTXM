import os
import json
import subprocess
import signal
import fcntl
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gio

STATUS_FILE = "/run/ph4ntxm-lockdown-status.json"
LOCKDOWN_SCRIPT = "/usr/local/bin/ph4ntxm-lockdown"
POLL_INTERVAL = 2

ICON_ENABLED = "lockdown-enabled"
ICON_DISABLED = "lockdown-disabled"


class LockdownTray:
    def __init__(self):
        self.icon = Gtk.StatusIcon()
        self.icon.set_name("ph4ntxm-lockdown-tray")
        self.icon.set_from_icon_name(ICON_DISABLED)
        self.icon.set_title("PH4NTXM Lockdown")
        self.icon.set_tooltip_text("PH4NTXM Lockdown")

        self.menu = Gtk.Menu()
        self.mi_enable = Gtk.MenuItem(label="Enable Lockdown")
        self.mi_enable.connect("activate", self.enable_lockdown)
        self.menu.append(self.mi_enable)

        self.mi_disable = Gtk.MenuItem(label="Disable Lockdown")
        self.mi_disable.connect("activate", self.disable_lockdown)
        self.menu.append(self.mi_disable)

        self.mi_quit = Gtk.MenuItem(label="Quit")
        self.mi_quit.connect("activate", self.quit_tray)
        self.menu.append(self.mi_quit)

        self.menu.show_all()
        self.icon.connect("activate", self.on_activate)
        self.icon.connect("popup-menu", self.on_popup_menu)
        self.icon.set_visible(True)

        self._last_state = None
        GLib.timeout_add_seconds(POLL_INTERVAL, self._poll_status)

    def on_activate(self, icon):
        self.on_popup_menu(icon, 1, Gtk.get_current_event_time())

    def on_popup_menu(self, icon, button, timestamp):
        self.menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, timestamp)

    def _read_status(self):
        try:
            if not os.path.exists(STATUS_FILE):
                return False
            with open(STATUS_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
            return bool(data.get("enabled", False))
        except:
            return False

    def _apply_state(self, enabled):
        self.icon.set_from_icon_name(ICON_ENABLED if enabled else ICON_DISABLED)
        title = f"PH4NTXM Lockdown: {'Enabled' if enabled else 'Disabled'}"
        self.icon.set_tooltip_text(title)
        self.mi_enable.set_sensitive(not enabled)
        self.mi_disable.set_sensitive(enabled)

    def _poll_status(self):
        state = self._read_status()
        if state != self._last_state:
            self._apply_state(state)
            self._last_state = state
        return True

    def enable_lockdown(self, _):
        subprocess.Popen(["/usr/bin/sudo", "-n", "/usr/local/sbin/ph4ntxm-firewall-control", "enable"])

    def disable_lockdown(self, _):
        subprocess.Popen(
            ["/usr/bin/sudo", "-A", "/usr/local/sbin/ph4ntxm-firewall-control", "disable"]
        )

    def quit_tray(self, _):
        Gtk.main_quit()


def main():
    with open("/run/ph4ntxm/tray/lockdown.lock", "rb") as instance_lock:
        try:
            fcntl.flock(instance_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return

        application = Gio.Application(application_id="org.ph4ntxm.LockdownTray")
        application.register(None)
        if application.get_is_remote():
            return

        signal.signal(signal.SIGINT, signal.SIG_DFL)
        LockdownTray()
        Gtk.main()


if __name__ == "__main__":
    main()
