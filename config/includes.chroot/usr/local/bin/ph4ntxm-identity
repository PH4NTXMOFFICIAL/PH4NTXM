#!/usr/bin/env python3
import os
import subprocess
import sys
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

CSS_FILE = "/usr/share/ph4ntxm/ph4ntxm-ui.css"
ICON_FILE = "/usr/share/icons/Lyra-blue-dark/apps/scalable/ph4ntxm-identity.svg"


def read(path, default="unknown"):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            value = handle.read().strip()
            return value or default
    except (OSError, UnicodeError):
        return default


def read_macs():
    macs = {}
    try:
        interfaces = sorted(os.listdir("/sys/class/net"))
    except OSError:
        return macs
    for interface in interfaces:
        if interface == "lo":
            continue
        mac = read(f"/sys/class/net/{interface}/address", "").lower()
        if mac and mac != "00:00:00:00:00:00":
            macs[interface] = mac
    return macs


def gather_identity():
    return {
        "Hostname": read("/etc/hostname"),
        "Machine ID": read("/etc/machine-id"),
        "MACs": read_macs(),
        "Clock": "Fuzzed according to the active mode profile",
        "Mode": read("/run/ph4ntxm/mode").upper(),
    }


def print_mode(info):
    print(f"Hostname: {info['Hostname']}")
    print(f"Machine ID: {info['Machine ID']}")
    if info["MACs"]:
        for interface, mac in info["MACs"].items():
            print(f"{interface}: {mac}")
    else:
        print("MACs: none")
    print(f"Clock: {info['Clock']}")


def add_class(widget, name):
    widget.get_style_context().add_class(name)
    return widget


def data_row(label_text, value_text, selectable=True):
    row = add_class(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18), "data-row")
    label = add_class(Gtk.Label(label=label_text), "data-label")
    label.set_halign(Gtk.Align.START)
    label.set_valign(Gtk.Align.START)
    row.pack_start(label, False, False, 0)
    value = add_class(Gtk.Label(label=value_text), "data-value")
    value.set_halign(Gtk.Align.END)
    value.set_valign(Gtk.Align.START)
    value.set_justify(Gtk.Justification.RIGHT)
    value.set_selectable(selectable)
    value.set_line_wrap(True)
    value.set_max_width_chars(46)
    row.pack_end(value, True, True, 0)
    return row


class IdentityWindow(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, title="PH4NTXM Identity")
        self.set_default_size(560, 430)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        if os.path.exists(ICON_FILE):
            self.set_icon_from_file(ICON_FILE)
        provider = Gtk.CssProvider()
        provider.load_from_path(CSS_FILE)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        add_class(self, "ph4ntxm-window")
        info = gather_identity()
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)
        header = add_class(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16), "top-panel")
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        title = add_class(Gtk.Label(label="PH4NTXM IDENTITY"), "title")
        title.set_halign(Gtk.Align.START)
        subtitle = add_class(Gtk.Label(label="Active session persona"), "subtitle")
        subtitle.set_halign(Gtk.Align.START)
        title_box.pack_start(title, False, False, 0)
        title_box.pack_start(subtitle, False, False, 0)
        header.pack_start(title_box, True, True, 0)
        mode = add_class(Gtk.Label(label=f"MODE  {info['Mode']}"), "status-pill")
        mode.get_style_context().add_class("status-active")
        header.pack_end(mode, False, False, 0)
        root.pack_start(header, False, False, 0)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_border_width(18)
        section = add_class(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2), "section")
        section_title = add_class(Gtk.Label(label="SESSION IDENTITY"), "section-title")
        section_title.set_halign(Gtk.Align.START)
        section.pack_start(section_title, False, False, 2)
        section.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 6)
        macs = info["MACs"]
        mac_text = "\n".join(f"{interface}: {mac}" for interface, mac in macs.items()) if macs else "none"
        section.pack_start(data_row("Hostname", info["Hostname"]), False, False, 0)
        section.pack_start(data_row("Machine ID", info["Machine ID"]), False, False, 0)
        section.pack_start(data_row("MAC addresses", mac_text), False, False, 0)
        section.pack_start(data_row("Clock persona", info["Clock"], False), False, False, 0)
        content.pack_start(section, True, True, 0)
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        report = Gtk.Button(label="Detailed health report")
        add_class(report, "primary")
        report.connect("clicked", self.open_report)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda _: self.close())
        controls.pack_end(close, False, False, 0)
        controls.pack_end(report, False, False, 0)
        content.pack_end(controls, False, False, 0)
        root.pack_start(content, True, True, 0)
        self.connect("destroy", Gtk.main_quit)

    def open_report(self, _):
        try:
            subprocess.Popen([
                "/usr/bin/xfce4-terminal",
                "--disable-server",
                "--class=PH4NTXM-Health",
                "--title=PH4NTXM Health Report",
                "--hold",
                "--command=/usr/local/bin/ph4ntxm-health",
            ])
        except OSError:
            pass


def main():
    if len(sys.argv) > 1 and sys.argv[1] in ("--print", "-p"):
        print_mode(gather_identity())
        return
    window = IdentityWindow()
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
