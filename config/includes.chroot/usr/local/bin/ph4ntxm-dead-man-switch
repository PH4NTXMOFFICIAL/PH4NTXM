import json
import os
import re
import selectors
import signal
import subprocess
import sys
import threading
import time
import unicodedata

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib, Gtk, Pango

sys.path.insert(0, "/usr/lib/ph4ntxm")
try:
    from dead_man_switch import read_snapshot
except ImportError:
    def read_snapshot():
        raise OSError("Dead Man's Switch status reader is unavailable")


CONTROL = "/usr/local/sbin/ph4ntxm-dead-man-switch-control"
CSS_FILE = "/usr/share/ph4ntxm/ph4ntxm-ui.css"
TITLE = "PH4NTXM Dead Man's Switch"
MAX_OUTPUT = 64 * 1024
HELPER_TIMEOUT = 120
STATES = {
    "disarmed": ("Disarmed", "status-disarmed"),
    "armed": ("Armed", "status-armed"),
    "warning": ("Panic in 60 seconds or less", "status-danger"),
    "triggered": ("Deadline reached", "status-danger"),
    "degraded": ("Status needs attention", "status-warning"),
}


def display_text(value, limit=512):
    return "".join(
        character if unicodedata.category(character) not in {"Cc", "Cf", "Cs"} else "�"
        for character in str(value)[:limit]
    )


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("Duplicate response field")
        result[key] = value
    return result


def validate_snapshot(data):
    if (
        not isinstance(data, dict)
        or type(data.get("ok")) is not bool
        or not isinstance(data.get("state"), str)
        or data["state"] not in STATES
        or not isinstance(data.get("generation"), str)
        or (data["generation"] and re.fullmatch(r"[0-9a-f]{32}", data["generation"]) is None)
        or not isinstance(data.get("message"), str)
        or any(
            type(data.get(key)) is not int or data[key] < 0
            for key in ("duration_seconds", "remaining_seconds", "deadline_boottime_ns")
        )
        or data["duration_seconds"] > 86400
        or data["remaining_seconds"] > 86400
        or (
            data["state"] in {"armed", "warning"}
            and (not data["generation"] or not data["deadline_boottime_ns"])
        )
    ):
        raise ValueError("Invalid Dead Man's Switch status")
    return {**data, "message": display_text(data["message"])}


def unavailable_snapshot(previous=None):
    data = {
        "ok": False,
        "state": "degraded",
        "generation": "",
        "duration_seconds": 0,
        "remaining_seconds": 0,
        "deadline_boottime_ns": 0,
        "message": "Cannot verify the timer. The root service continues independently.",
    }
    if previous and (is_active(previous) or previous["state"] == "triggered"):
        for key in ("generation", "duration_seconds", "deadline_boottime_ns"):
            data[key] = previous[key]
        data["remaining_seconds"] = max(
            0,
            (data["deadline_boottime_ns"] - time.clock_gettime_ns(time.CLOCK_BOOTTIME)
             + 999999999) // 1000000000,
        )
        data["message"] = "Cannot verify the timer. Its last known deadline still applies."
        if previous["state"] == "triggered":
            data["message"] = "Cannot verify the timer. Its deadline was reached and Panic was requested."
    return data


def is_active(snapshot):
    return snapshot["state"] in {"armed", "warning"} or (
        snapshot["state"] == "degraded" and snapshot["deadline_boottime_ns"] > 0
    )


def controls(snapshot, busy=False):
    idle = not busy
    active = is_active(snapshot) and snapshot["remaining_seconds"] > 0
    return {
        "arm": idle and snapshot["ok"] and snapshot["state"] == "disarmed",
        "renew": idle and snapshot["ok"] and active and bool(snapshot["generation"]),
        "disarm": idle and active and bool(snapshot["generation"]),
    }


def format_remaining(seconds):
    seconds = max(0, seconds)
    hours, remainder = divmod(seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}" if hours else f"{minutes:02d}:{seconds:02d}"


class HelperCall:
    def __init__(self, action, generation, minutes=None):
        if action not in {"arm", "renew", "disarm"}:
            raise ValueError("Invalid Dead Man's Switch action")
        if not isinstance(generation, str) or (
            generation and re.fullmatch(r"[0-9a-f]{32}", generation) is None
        ):
            raise ValueError("Invalid timer generation")
        payload = {"generation": generation}
        if action in {"arm", "renew"}:
            if type(minutes) is not int or not 1 <= minutes <= 1440:
                raise ValueError("Duration must be 1 to 1440 minutes")
            payload["minutes"] = minutes
        self.action = action
        self.input = json.dumps(payload, separators=(",", ":")).encode("ascii") + b"\n"
        self.cancelled = threading.Event()
        self.process = None
        self.lock = threading.Lock()

    def stop_process(self, force=False, nonblocking=False):
        if not self.lock.acquire(blocking=not nonblocking):
            return
        try:
            process = self.process
            if process is not None and process.poll() is None:
                try:
                    os.killpg(process.pid, signal.SIGKILL if force else signal.SIGTERM)
                except OSError:
                    pass
        finally:
            self.lock.release()

    def cancel(self):
        self.cancelled.set()
        self.stop_process(nonblocking=True)

    def run_process(self, command, environment):
        process = None
        try:
            if self.cancelled.is_set():
                raise InterruptedError("Request cancelled")
            process = subprocess.Popen(
                command,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                env=environment,
                close_fds=True,
                start_new_session=True,
            )
            with self.lock:
                self.process = process
            if self.cancelled.is_set():
                raise InterruptedError("Request cancelled")
            process.stdin.write(self.input)
            process.stdin.close()
            os.set_blocking(process.stdout.fileno(), False)
            output = bytearray()
            deadline = time.monotonic() + HELPER_TIMEOUT
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while selector.get_map() or process.poll() is None:
                    if self.cancelled.is_set():
                        raise InterruptedError("Request cancelled")
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TimeoutError("Request timed out")
                    for key, _ in selector.select(min(0.2, remaining)):
                        chunk = os.read(key.fileobj.fileno(), 8192)
                        if not chunk:
                            selector.unregister(key.fileobj)
                        elif len(output) + len(chunk) > MAX_OUTPUT:
                            raise ValueError("Response is too large")
                        else:
                            output.extend(chunk)
                    if not selector.get_map() and process.poll() is None:
                        self.cancelled.wait(min(0.05, remaining))
            if self.cancelled.is_set():
                raise InterruptedError("Request cancelled")
            return process.returncode, bytes(output)
        finally:
            if process is not None:
                if process.poll() is None:
                    self.stop_process()
                    try:
                        process.wait(timeout=1)
                    except subprocess.TimeoutExpired:
                        self.stop_process(force=True)
                        try:
                            process.wait(timeout=1)
                        except subprocess.TimeoutExpired:
                            pass
                for stream in (process.stdin, process.stdout):
                    if stream is not None and not stream.closed:
                        try:
                            stream.close()
                        except OSError:
                            pass
            with self.lock:
                self.process = None

    def run(self):
        environment = dict(os.environ)
        environment["SUDO_ASKPASS"] = "/usr/local/bin/ph4ntxm-askpass"
        try:
            code, output = self.run_process(
                ["/usr/bin/sudo", "-A", "-k", "--", CONTROL, self.action],
                environment,
            )
            result = json.loads(output.decode("utf-8"), object_pairs_hook=unique_object)
            if isinstance(result, dict) and result.get("ok") is False:
                return {
                    "ok": False,
                    "error": display_text(result.get("error") or result.get("message") or "Request failed"),
                }
            if code != 0 or not isinstance(result, dict) or result.get("ok") is not True:
                return {"ok": False, "error": "Authorization cancelled or request failed. Status refreshed."}
            return {"ok": True}
        except InterruptedError:
            return {"ok": False, "error": "Request cancelled. Status refreshed; cancellation may follow a completed action."}
        except TimeoutError:
            return {"ok": False, "error": "Request timed out. Status refreshed; the action may have completed."}
        except (OSError, UnicodeError, ValueError, RecursionError, subprocess.SubprocessError):
            return {"ok": False, "error": "Could not confirm the request. Status refreshed."}


def add_class(widget, name):
    widget.get_style_context().add_class(name)
    return widget


def label(text, style=None, lines=2):
    widget = Gtk.Label(label=text, xalign=0)
    widget.set_line_wrap(True)
    widget.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    widget.set_max_width_chars(66)
    widget.set_lines(lines)
    return add_class(widget, style) if style else widget


class DeadManWindow(Gtk.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title=TITLE)
        self.controller = application
        self.set_default_size(600, 460)
        self.set_resizable(False)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name(application.icon_name)
        add_class(self, "ph4ntxm-window")
        self.connect("delete-event", self.on_close)
        self.build()

    def build(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)
        header = add_class(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4), "top-panel")
        header.pack_start(label(TITLE, "title", 1), False, False, 0)
        header.pack_start(label("Renew before time runs out", "subtitle", 1), False, False, 0)
        root.pack_start(header, False, False, 0)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_border_width(16)
        root.pack_start(content, True, True, 0)
        status = add_class(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6), "section")
        self.status = label("Checking timer", "section-title", 1)
        status.pack_start(self.status, False, False, 0)
        self.countdown = label("— — : — —", "title", 1)
        self.countdown.set_halign(Gtk.Align.CENTER)
        self.countdown.set_margin_top(4)
        self.countdown.set_margin_bottom(4)
        attributes = Pango.AttrList()
        attributes.insert(Pango.attr_family_new("monospace"))
        attributes.insert(Pango.attr_scale_new(1.65))
        self.countdown.set_attributes(attributes)
        status.pack_start(self.countdown, False, False, 0)
        self.status_message = label("Reading the root service status…", "subtitle", 2)
        status.pack_start(self.status_message, False, False, 0)
        content.pack_start(status, False, False, 0)
        duration = Gtk.Box(spacing=10)
        duration.pack_start(label("Interval", "section-title", 1), False, False, 0)
        self.minutes = Gtk.SpinButton.new_with_range(1, 1440, 1)
        self.minutes.set_numeric(True)
        self.minutes.set_snap_to_ticks(True)
        self.minutes.set_value(15)
        self.minutes.set_width_chars(5)
        self.minutes.set_tooltip_text("1–1440 minutes. Renew starts the selected interval from now.")
        self.minutes.get_accessible().set_name("Timer interval in minutes")
        duration.pack_start(self.minutes, False, False, 0)
        duration.pack_start(label("minutes", "subtitle", 1), False, False, 0)
        content.pack_start(duration, False, False, 0)
        content.pack_start(
            label("At expiry, Panic runs automatically without confirmation.\nRenew starts the selected interval from now.", "subtitle", 2),
            False, False, 0,
        )
        actions = Gtk.Box(spacing=10)
        self.buttons = {}
        for action, text, style in (
            ("arm", "Arm", "primary"),
            ("renew", "Renew", "primary"),
            ("disarm", "Disarm", "safe"),
        ):
            button = add_class(Gtk.Button(label=text), style)
            button.connect("clicked", self.on_action, action)
            actions.pack_start(button, True, True, 0)
            self.buttons[action] = button
        content.pack_start(actions, False, False, 0)
        content.pack_start(label("Every action requires your password.\nClosing this window keeps an armed timer running.", "subtitle", 2), False, False, 0)
        footer = Gtk.Box(spacing=10)
        self.spinner = Gtk.Spinner()
        self.spinner.set_no_show_all(True)
        footer.pack_start(self.spinner, False, False, 0)
        self.notice = label("", "subtitle", 3)
        footer.pack_start(self.notice, True, True, 0)
        close = Gtk.Button(label="Close")
        close.set_valign(Gtk.Align.END)
        close.connect("clicked", self.on_close)
        footer.pack_end(close, False, False, 0)
        content.pack_start(footer, False, False, 0)

    def update(self):
        snapshot = self.controller.snapshot
        title, style = STATES[snapshot["state"]]
        self.status.set_text(title)
        context = self.status.get_style_context()
        for _, candidate in STATES.values():
            context.remove_class(candidate)
        context.add_class(style)
        self.status_message.set_text(snapshot["message"])
        self.countdown.set_text(
            format_remaining(snapshot["remaining_seconds"])
            if is_active(snapshot) or snapshot["state"] == "triggered"
            else "— — : — —"
        )
        for action, enabled in controls(snapshot, self.controller.job is not None).items():
            self.buttons[action].set_sensitive(enabled)
        self.minutes.set_sensitive(self.controller.job is None)
        self.notice.set_text(self.controller.notice)
        if self.controller.job is None:
            self.spinner.stop()
            self.spinner.hide()
        else:
            self.spinner.show()
            self.spinner.start()

    def on_action(self, _button, action):
        self.minutes.update()
        self.controller.request(action, self.minutes.get_value_as_int())

    def on_close(self, *_):
        self.hide()
        self.controller.close_window()
        return True


class DeadManApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.ph4ntxm.DeadManSwitch", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.snapshot = unavailable_snapshot()
        self.window = None
        self.job = None
        self.notice = ""
        self.poll_source = 0
        self.stopping = False
        self.closing = False
        self.icon_name = "ph4ntxm-panic-button"
        self.connect("startup", self.on_startup)
        self.connect("command-line", self.on_command_line)
        self.connect("activate", self.present_controls)
        self.connect("shutdown", self.on_shutdown)

    def on_startup(self, *_):
        theme = Gtk.IconTheme.get_default()
        if theme and theme.has_icon("ph4ntxm-dead-man-switch"):
            self.icon_name = "ph4ntxm-dead-man-switch"
        if os.path.isfile(CSS_FILE):
            provider = Gtk.CssProvider()
            try:
                provider.load_from_path(CSS_FILE)
                from gi.repository import Gdk
                Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            except GLib.Error:
                pass
        self.poll_source = GLib.timeout_add(500, self.refresh)
        self.refresh()
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, self.stop)
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, self.stop)

    def on_command_line(self, _application, command_line):
        arguments = command_line.get_arguments()[1:]
        if arguments:
            command_line.printerr("Usage: ph4ntxm-dead-man-switch\n")
            return 2
        self.present_controls()
        return 0

    def present_controls(self, *_):
        if self.stopping or self.closing:
            return
        if self.window is None:
            self.window = DeadManWindow(self)
        self.refresh()
        self.window.update()
        self.window.show_all()
        self.window.present()

    def refresh(self):
        if self.stopping:
            return False
        try:
            snapshot = validate_snapshot(read_snapshot())
            if (
                snapshot["state"] == "degraded"
                and not snapshot["deadline_boottime_ns"]
                and (is_active(self.snapshot) or self.snapshot["state"] == "triggered")
            ):
                snapshot = unavailable_snapshot(self.snapshot)
        except (OSError, ValueError, TypeError, RuntimeError, OverflowError, RecursionError):
            snapshot = unavailable_snapshot(self.snapshot)
        self.snapshot = snapshot
        if self.window is not None:
            self.window.update()
        return True

    def request(self, action, minutes):
        self.refresh()
        if self.stopping or self.closing or not controls(self.snapshot, self.job is not None).get(action, False):
            return
        job = HelperCall(action, self.snapshot["generation"], minutes)
        self.job = job
        self.notice = "Enter your password to authorize this action…"
        if self.window is not None:
            self.window.update()

        def worker():
            try:
                result = job.run()
            except Exception:
                result = {"ok": False, "error": "Request could not complete. Status refreshed."}
            GLib.idle_add(self.finish, job, result)

        try:
            threading.Thread(target=worker, daemon=True).start()
        except (RuntimeError, OSError):
            self.finish(job, {"ok": False, "error": "Request could not start. Status refreshed."})

    def finish(self, job, result):
        if self.job is not job:
            return False
        self.job = None
        self.notice = (
            "Request completed. Current timer status shown above."
            if result.get("ok") is True
            else display_text(result.get("error") or "Could not confirm the request. Status refreshed.")
        )
        self.refresh()
        if self.stopping or self.closing:
            self.complete_close()
        return False

    def close_window(self):
        self.closing = True
        if self.window is not None:
            self.window.hide()
        if self.job is not None:
            self.notice = "Cancelling authorization. The timer state will be checked again."
            self.job.cancel()
        self.refresh()
        if self.job is None:
            self.complete_close()

    def complete_close(self):
        if self.window is not None:
            self.window.destroy()
            self.window = None
        self.quit()

    def stop(self):
        if self.stopping:
            return False
        self.stopping = True
        if self.poll_source:
            GLib.source_remove(self.poll_source)
            self.poll_source = 0
        if self.job is not None:
            self.job.cancel()
        else:
            self.complete_close()
        return False

    def on_shutdown(self, *_):
        if self.poll_source:
            GLib.source_remove(self.poll_source)
            self.poll_source = 0
        if self.job is not None:
            self.job.cancel()


def main():
    return DeadManApplication().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
