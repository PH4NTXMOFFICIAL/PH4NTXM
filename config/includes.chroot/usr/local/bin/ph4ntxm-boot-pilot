#!/usr/bin/env python3
import ctypes
import json
import hashlib
import os
import re
import resource
import subprocess
import threading
import time
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk, GLib

STATE_DIR = "/run/ph4ntxm"
SYSTEMCTL = "/usr/bin/systemctl"
SS = "/usr/bin/ss"
IP = "/usr/sbin/ip"
SUDO = "/usr/bin/sudo"
WIFI_CONTROL = "/usr/local/sbin/ph4ntxm-wifi-control"


def harden_process():
    try:
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    except (OSError, ValueError):
        pass
    try:
        ctypes.CDLL(None, use_errno=True).prctl(4, 0, 0, 0, 0)
    except (AttributeError, OSError):
        pass


harden_process()


def read(path, default=""):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except (OSError, UnicodeError):
        return default


def run(command, timeout=2):
    try:
        result = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
            check=False,
        )
        return result.returncode, result.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def run_json(command, timeout=15, input_data=None):
    try:
        result = subprocess.run(
            command,
            input=input_data,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=timeout,
            check=False,
        )
        try:
            payload = json.loads(result.stdout)
        except (TypeError, ValueError):
            payload = {"ok": False, "error": "Wi-Fi control returned an invalid response"}
        if result.returncode != 0 and payload.get("ok") is not False:
            payload = {"ok": False, "error": "Wi-Fi control failed"}
        return payload
    except subprocess.TimeoutExpired:
        return {"ok": False, "error": "Wi-Fi operation timed out"}
    except OSError:
        return {"ok": False, "error": "Wi-Fi control is unavailable"}


def active(unit):
    code, output = run([SYSTEMCTL, "is-active", unit])
    return code == 0 and output == "active"


def privileged_read(path):
    code, output = run([SUDO, "-n", "/usr/bin/cat", path])
    return output if code == 0 else ""


def protected_file(path):
    try:
        info = os.lstat(path)
        return os.path.isfile(path) and not os.path.islink(path) and info.st_uid == 0 and not info.st_mode & 0o022
    except OSError:
        return False


def state_values(path, required):
    if not protected_file(path):
        return None
    values = {}
    for line in read(path).splitlines():
        if "=" not in line:
            return None
        key, value = line.split("=", 1)
        if key in values:
            return None
        values[key] = value
    return values if set(values) == set(required) else None


def fresh_uptime(value, limit=6):
    try:
        recorded = int(value)
        current = int(read("/proc/uptime").split(".", 1)[0])
        return 0 <= current - recorded <= limit
    except (IndexError, TypeError, ValueError):
        return False


def listener(protocol, port):
    flag = "-ltn4" if protocol == "tcp" else "-lun4"
    code, output = run([SS, "-H", flag, f"sport = :{port}"])
    endpoint = f"127.0.0.1:{port}"
    return code == 0 and any(len(fields := line.split()) > 3 and fields[3] == endpoint for line in output.splitlines())


def tor_ready():
    values = state_values(f"{STATE_DIR}/tor-ready", ("STATUS", "BOOTSTRAP", "UPTIME_SECONDS"))
    return bool(values and values["STATUS"] == "ready" and values["BOOTSTRAP"] == "100" and fresh_uptime(values["UPTIME_SECONDS"]))


def firewall_ready(mode):
    path = f"{STATE_DIR}/firewall-ready"
    if mode == "lonewolf":
        values = state_values(path, ("PROFILE", "SOURCE_SHA256", "RULESET_SHA256", "UPTIME_SECONDS"))
        if values and values["PROFILE"] == "lonewolf":
            manifest = "/usr/lib/ph4ntxm/lonewolf/lonewolf.nft.sha256"
            source = read(manifest) if protected_file(manifest) else ""
        elif values and values["PROFILE"] == "lockdown":
            manifest = "/etc/firewall/rules.sha256"
            source = ""
            if protected_file(manifest):
                matches = [line.split()[0] for line in read(manifest).splitlines() if line.split()[1:] == ["/etc/firewall/lockdown.nft"]]
                source = matches[0] if len(matches) == 1 else ""
        else:
            source = ""
        return bool(
            values
            and values["PROFILE"] in {"lonewolf", "lockdown"}
            and re.fullmatch(r"[0-9a-f]{64}", values["RULESET_SHA256"])
            and fresh_uptime(values["UPTIME_SECONDS"])
            and re.fullmatch(r"[0-9a-f]{64}", source)
            and values["SOURCE_SHA256"] == source
        )
    values = state_values(path, ("PROFILE", "RULESET_SHA256", "UPTIME_SECONDS"))
    return bool(
        values
        and values["PROFILE"] in {"normal", "lockdown"}
        and re.fullmatch(r"[0-9a-f]{64}", values["RULESET_SHA256"])
        and fresh_uptime(values["UPTIME_SECONDS"])
    )


def normal_packet_transformation_engine_state(mode):
    firewall = state_values(
        f"{STATE_DIR}/firewall-ready",
        ("PROFILE", "RULESET_SHA256", "UPTIME_SECONDS"),
    )
    guard_state = state_values(
        f"{STATE_DIR}/packet-transformation-engine-guard-ready",
        ("STATUS", "PROFILE", "INTERFACES", "UPTIME_SECONDS"),
    )
    guard_ready = bool(
        guard_state
        and firewall
        and guard_state["STATUS"] == "ready"
        and guard_state["PROFILE"] in {"normal", "lockdown"}
        and guard_state["PROFILE"] == firewall["PROFILE"]
        and guard_state["INTERFACES"].isdigit()
        and fresh_uptime(guard_state["UPTIME_SECONDS"])
        and active("ph4ntxm-packet-transformation-engine-guard.service")
    )
    return (
        active("ph4ntxm-packet-transformation-engine.service") and guard_ready,
        active("ph4ntxm-nft-rules.service"),
        active("ph4ntxm-firewall-guard.service") and firewall_ready(mode),
    )


def feature(label, is_active):
    return {
        "label": label,
        "state": "pass" if is_active else "fail",
        "detail": "ACTIVE" if is_active else "INACTIVE",
        "critical": True,
    }


def completed(unit):
    code, output = run([
        SYSTEMCTL,
        "show",
        unit,
        "--property=Result",
        "--property=ExecMainStatus",
        "--property=ExecMainStartTimestampMonotonic",
    ])
    values = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
    return (
        code == 0
        and values.get("Result") == "success"
        and values.get("ExecMainStatus") == "0"
        and values.get("ExecMainStartTimestampMonotonic", "0") != "0"
    )


def nonempty(path):
    try:
        return os.path.isfile(path) and os.path.getsize(path) > 0
    except OSError:
        return False


def directory_has_files(path):
    try:
        return os.path.isdir(path) and any(
            os.path.isfile(os.path.join(path, name)) or os.path.islink(os.path.join(path, name))
            for name in os.listdir(path)
        )
    except OSError:
        return False


def physical_interfaces():
    try:
        return sorted(
            name
            for name in os.listdir("/sys/class/net")
            if name != "lo" and os.path.isdir(f"/sys/class/net/{name}/device")
        )
    except OSError:
        return []


def session_mac_ready(mode):
    interfaces = physical_interfaces()
    if mode not in {"linux", "windows", "lonewolf"}:
        return False
    if mode in {"linux", "windows"}:
        seed = privileged_read(f"{STATE_DIR}/persona_seed")
        base_mac = privileged_read(f"{STATE_DIR}/boot_mac")
        parts = base_mac.lower().split(":")
        if not re.fullmatch(r"[0-9a-f]{64}", seed) or len(parts) != 6:
            return False
        prefix = parts[:3]
    for interface in interfaces:
        if read(f"/sys/class/net/{interface}/carrier", "0") != "1":
            continue
        current = read(f"/sys/class/net/{interface}/address").lower()
        if mode == "lonewolf":
            expected = privileged_read(f"{STATE_DIR}/boot_mac/{interface}").lower()
        else:
            suffix = []
            for index in range(4, 7):
                digest = hashlib.sha256(f"{seed}m{index}-{interface}".encode("utf-8")).hexdigest()
                suffix.append(digest[6:8])
            expected = ":".join(prefix + suffix)
        if not re.fullmatch(r"[0-9a-f]{2}(?::[0-9a-f]{2}){5}", expected) or current != expected:
            return False
    return True


def browser_feature(mode):
    if not completed("ph4ntxm-browser-mode.service"):
        return False
    if mode == "lonewolf":
        marker = state_values(f"{STATE_DIR}/tor-browser-verified", ("MODE", "MANIFEST_SHA256", "UPTIME_SECONDS"))
        manifest = "/usr/lib/ph4ntxm/browser-mode/tor-browser.sha256"
        if not marker or marker["MODE"] != "lonewolf" or not protected_file(manifest):
            return False
        try:
            with open(manifest, "rb") as handle:
                digest = hashlib.sha256(handle.read()).hexdigest()
        except OSError:
            return False
        code, options = run(["/usr/bin/findmnt", "-rn", "-o", "OPTIONS", "--mountpoint", "/usr/lib/firefox-esr"])
        desktop = read("/usr/share/applications/firefox-esr.desktop")
        return (
            marker["MANIFEST_SHA256"] == digest
            and code == 0
            and {"ro", "nosuid", "nodev", "noexec"}.issubset(set(options.split(",")))
            and re.search(r"^Name=Tor Browser$", desktop, re.MULTILINE) is not None
        )
    if not completed("ph4ntxm-browser-policy.service") or not nonempty(f"/etc/firefox-esr/mode/{mode}/user.js"):
        return False
    try:
        with open("/etc/firefox/policies/policies.json", "r", encoding="utf-8") as handle:
            policies = json.load(handle)["policies"]
    except (OSError, KeyError, TypeError, ValueError):
        return False
    if policies.get("DisableTelemetry") is not True:
        return False
    return policies.get("DNSOverHTTPS") == {"Enabled": False}


def identity_features(mode):
    lonewolf = mode == "lonewolf"
    prefix = "ph4ntxm-lonewolf" if lonewolf else "ph4ntxm"
    seed = f"{STATE_DIR}/lonewolf_seed" if lonewolf else f"{STATE_DIR}/persona_seed"
    machine_id = read("/etc/machine-id")
    identity_ok = (
        active(f"{prefix}-identity-randomization.service")
        and read(f"{STATE_DIR}/identity-ready") == mode
        and nonempty(seed)
        and nonempty(f"{STATE_DIR}/boot_hostname")
        and os.path.exists(f"{STATE_DIR}/boot_mac")
        and bool(re.fullmatch(r"[0-9a-f]{32}", machine_id))
        and machine_id == read(f"{STATE_DIR}/boot_machine_id")
    )
    hardware_ok = completed(f"{prefix}-hardware-randomization.service") and nonempty(f"{STATE_DIR}/boot_jitter") and directory_has_files(f"{STATE_DIR}/fake_dmi")
    cores_ok = active(f"{prefix}-cores-randomization.service") and nonempty(f"{STATE_DIR}/cores_env")
    cpu_ok = active(f"{prefix}-cpu-spoof.service") and nonempty(f"{STATE_DIR}/fake_cpuinfo") and nonempty(f"{STATE_DIR}/fake_online")
    gpu_ok = completed(f"{prefix}-gpu-randomization.service") and nonempty(f"{STATE_DIR}/gpu_env")
    screen_ok = active(f"{prefix}-screen-randomization.service") and nonempty(f"{STATE_DIR}/screen_env") and nonempty(f"{STATE_DIR}/browser_env")
    fonts_ok = active("ph4ntxm-fonts-randomization.service") and nonempty(f"{STATE_DIR}/fonts-active/fonts.conf") and directory_has_files(f"{STATE_DIR}/fonts-active")
    clock = read(f"{STATE_DIR}/clock-fuzz-profile")
    clock_ok = active("ph4ntxm-clock-fuzz.service") and re.search(r"^SKEW_APPLIED=1$", clock, re.MULTILINE) is not None
    return [
        feature("Identity randomization", identity_ok),
        feature("Hardware randomization", hardware_ok),
        feature("Core randomization", cores_ok),
        feature("CPU spoofing", cpu_ok),
        feature("GPU randomization", gpu_ok),
        feature("Screen randomization", screen_ok),
        feature("Font randomization", fonts_ok),
        feature("Clock randomization", clock_ok),
        feature("Browser persona", browser_feature(mode)),
    ]


def network_features(mode):
    lonewolf = mode == "lonewolf"
    prefix = "ph4ntxm-lonewolf" if lonewolf else "ph4ntxm"
    net_ok = completed(f"{prefix}-net-randomization.service")
    if lonewolf:
        net_ok = net_ok and read("/proc/sys/net/ipv6/conf/all/disable_ipv6", "0") == "1"
    else:
        expected_ttl = "128" if mode == "windows" else "64"
        net_ok = net_ok and nonempty(f"{STATE_DIR}/net/rtt_map") and read("/proc/sys/net/ipv4/ip_default_ttl") == expected_ttl
    session = privileged_read(f"{STATE_DIR}/session_dhcp")
    dhcp_ok = completed(f"{prefix}-dhcp-session-generator.service") and re.search(rf"^MODE={re.escape(mode)}$", session, re.MULTILINE) is not None
    local_dns = re.search(r"^nameserver\s+127\.0\.0\.1\s*$", read("/etc/resolv.conf"), re.MULTILINE) is not None
    checks = [
        feature("Network randomization", net_ok),
        feature("Session MAC protection", session_mac_ready(mode)),
        feature("DHCP persona", dhcp_ok),
    ]
    if lonewolf:
        firewall_ok = active("ph4ntxm-lonewolf-firewall-guard.service") and firewall_ready(mode)
        tor_ok = active("tor@default.service") and tor_ready() and listener("tcp", 9040) and listener("tcp", 9050)
        dns_ok = active("ph4ntxm-lonewolf-dns.service") and local_dns and listener("tcp", 53) and listener("udp", 53) and listener("udp", 5353)
        checks.extend([feature("Firewall protection", firewall_ok), feature("Tor routing", tor_ok), feature("DNS protection", dns_ok)])
    else:
        packet_transformation_engine_active, rules_active, firewall_active = normal_packet_transformation_engine_state(mode)
        checks.extend([
            feature("Firewall protection", rules_active and firewall_active),
            feature("Packet transformation", packet_transformation_engine_active),
            feature("DNS protection", active("unbound.service") and local_dns),
            feature("Network drift", active("ph4ntxm-net-drift.service")),
            feature("Ghost stack", active("ph4ntxm-net-ghost-stack.service") and nonempty(f"{STATE_DIR}/ghost_stack")),
        ])
    return checks


def system_features():
    swap_total = -1
    for line in read("/proc/meminfo").splitlines():
        if line.startswith("SwapTotal:"):
            try:
                swap_total = int(line.split()[1])
            except (IndexError, ValueError):
                swap_total = -1
            break
    nuke_ok = active("ph4ntxm-arm-nuke.service") and read("/sys/kernel/kexec_crash_loaded", "0") == "1" and read("/proc/sys/kernel/kexec_load_disabled", "0") == "1" and nonempty("/boot/nuke/vmlinuz-nuke") and nonempty("/boot/nuke/initrd-nuke.img")
    return [
        feature("RAM protection", active("ph4ntxm-ram-seeding-engine.service") and swap_total == 0),
        feature("CPU lockdown", active("ph4ntxm-cpu-lockdown.service")),
        feature("Nuke protection", nuke_ok),
        feature("OPSEC monitoring", active("ph4ntxm-opsec-connwatch.service")),
    ]


def collect():
    mode = read(f"{STATE_DIR}/mode", "unknown")
    return [
        {"name": "IDENTITY PROTECTION", "checks": identity_features(mode)},
        {"name": "NETWORK PROTECTION", "checks": network_features(mode)},
        {"name": "SYSTEM PROTECTION", "checks": system_features()},
    ]


def overall(groups):
    checks = [check for group in groups for check in group["checks"]]
    inactive = [check for check in checks if check["state"] == "fail"]
    if inactive:
        return "unsafe", "NOT READY", f"{len(inactive)} protection feature{'s' if len(inactive) != 1 else ''} inactive"
    return "ready", "READY", "All protection features active"


class IndicatorRow(Gtk.Box):
    def __init__(self, check):
        Gtk.Box.__init__(self, orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.get_style_context().add_class("check-row")
        dot = Gtk.Label(label="●")
        dot.get_style_context().add_class(f"dot-{check['state']}")
        dot.set_valign(Gtk.Align.CENTER)
        self.pack_start(dot, False, False, 0)
        label = Gtk.Label(label=check["label"])
        label.set_halign(Gtk.Align.START)
        label.set_hexpand(True)
        self.pack_start(label, True, True, 0)
        detail = Gtk.Label(label=check["detail"])
        detail.set_halign(Gtk.Align.END)
        detail.set_selectable(True)
        detail.get_style_context().add_class(f"text-{check['state']}")
        self.pack_end(detail, False, False, 0)


class WifiDialog(Gtk.Dialog):
    def __init__(self, parent):
        Gtk.Dialog.__init__(self, title="Connect to Wi-Fi", transient_for=parent, modal=True)
        self.parent_pilot = parent
        self.selected = None
        self.connecting = False
        self.set_default_size(520, 520)
        self.set_resizable(True)
        self.set_destroy_with_parent(True)
        self.set_icon_name("network-wireless")
        self.connect("response", self.on_response)

        content = self.get_content_area()
        content.set_spacing(12)
        content.set_border_width(18)

        heading = Gtk.Label(label="SELECT A WIRELESS NETWORK")
        heading.set_halign(Gtk.Align.START)
        heading.get_style_context().add_class("section-title")
        content.pack_start(heading, False, False, 0)

        intro = Gtk.Label(label="The connection is created as a volatile NetworkManager profile for this live session.")
        intro.set_halign(Gtk.Align.START)
        intro.set_line_wrap(True)
        intro.get_style_context().add_class("subtitle")
        content.pack_start(intro, False, False, 0)

        self.network_list = Gtk.ListBox()
        self.network_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.network_list.set_activate_on_single_click(False)
        self.network_list.connect("row-selected", self.on_network_selected)
        self.network_list.connect("row-activated", self.on_network_activated)
        self.network_list.get_style_context().add_class("network-list")

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_min_content_height(245)
        scroll.set_shadow_type(Gtk.ShadowType.IN)
        scroll.add(self.network_list)
        content.pack_start(scroll, True, True, 0)

        self.password_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.password_box.set_no_show_all(True)
        password_label = Gtk.Label(label="Wi-Fi password")
        password_label.set_halign(Gtk.Align.START)
        self.password_box.pack_start(password_label, False, False, 0)
        password_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.password_entry = Gtk.Entry()
        self.password_entry.set_visibility(False)
        self.password_entry.set_invisible_char("•")
        self.password_entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        self.password_entry.set_max_length(64)
        self.password_entry.set_hexpand(True)
        self.password_entry.connect("changed", lambda _: self.update_connect_button())
        self.password_entry.connect("activate", lambda _: self.begin_connect() if self.connect_button.get_sensitive() else None)
        password_row.pack_start(self.password_entry, True, True, 0)
        reveal = Gtk.CheckButton(label="Show")
        reveal.connect("toggled", lambda button: self.password_entry.set_visibility(button.get_active()))
        password_row.pack_end(reveal, False, False, 0)
        self.password_box.pack_start(password_row, False, False, 0)
        content.pack_start(self.password_box, False, False, 0)

        status_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.spinner = Gtk.Spinner()
        status_row.pack_start(self.spinner, False, False, 0)
        self.status_label = Gtk.Label(label="Scanning for wireless networks…")
        self.status_label.set_halign(Gtk.Align.START)
        self.status_label.set_line_wrap(True)
        self.status_label.set_hexpand(True)
        self.status_label.get_style_context().add_class("subtitle")
        status_row.pack_start(self.status_label, True, True, 0)
        content.pack_start(status_row, False, False, 0)

        self.cancel_button = self.add_button("Cancel", Gtk.ResponseType.CANCEL)
        self.rescan_button = self.add_button("Rescan", Gtk.ResponseType.HELP)
        self.connect_button = self.add_button("Connect", Gtk.ResponseType.APPLY)
        self.connect_button.get_style_context().add_class("suggested-action")
        self.connect_button.set_sensitive(False)

    def set_status(self, message, style="subtitle", spinning=False):
        context = self.status_label.get_style_context()
        for css_class in ("subtitle", "text-pass", "text-fail", "text-warn"):
            context.remove_class(css_class)
        context.add_class(style)
        self.status_label.set_text(message)
        if spinning:
            self.spinner.start()
            self.spinner.show()
        else:
            self.spinner.stop()
            self.spinner.hide()

    def refresh_networks(self):
        if self.connecting:
            return
        self.rescan_button.set_sensitive(False)
        self.connect_button.set_sensitive(False)
        self.set_status("Scanning for wireless networks…", spinning=True)
        self.parent_pilot.request_wifi_state(rescan=True, callback=self.populate)

    def populate(self, state):
        if not self.get_visible():
            return
        self.rescan_button.set_sensitive(True)
        self.selected = None
        self.password_entry.set_text("")
        self.password_box.hide()
        for child in self.network_list.get_children():
            self.network_list.remove(child)
        if not state.get("ok"):
            self.set_status(state.get("error", "Unable to scan for wireless networks"), "text-fail")
            return
        if not state.get("hardware_enabled"):
            self.set_status("Wireless radio is blocked by hardware or firmware", "text-fail")
            return
        if not state.get("device_count"):
            self.set_status("No wireless adapter was detected", "text-fail")
            return
        networks = state.get("networks", [])
        for network in networks:
            row = Gtk.ListBoxRow()
            row._network = network
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            box.set_border_width(10)
            strength = network.get("strength", 0)
            if strength >= 75:
                icon_name = "network-wireless-signal-excellent-symbolic"
            elif strength >= 50:
                icon_name = "network-wireless-signal-good-symbolic"
            elif strength >= 25:
                icon_name = "network-wireless-signal-ok-symbolic"
            else:
                icon_name = "network-wireless-signal-weak-symbolic"
            box.pack_start(Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON), False, False, 0)
            labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            ssid = Gtk.Label(label=network.get("ssid", "Unknown network"))
            ssid.set_halign(Gtk.Align.START)
            labels.pack_start(ssid, False, False, 0)
            frequency = network.get("frequency", 0)
            band = "6 GHz" if frequency >= 5925 else "5 GHz" if frequency >= 4900 else "2.4 GHz" if frequency >= 2400 else "Unknown band"
            bssid = network.get("bssid", "")
            details = Gtk.Label(label=f"{network.get('security', 'Unknown')}  •  {strength}%  •  {band}  •  {bssid}")
            details.set_halign(Gtk.Align.START)
            details.set_ellipsize(3)
            details.get_style_context().add_class("subtitle")
            labels.pack_start(details, False, False, 0)
            box.pack_start(labels, True, True, 0)
            if network.get("active"):
                connected = Gtk.Label(label="CONNECTED")
                connected.get_style_context().add_class("text-pass")
                box.pack_end(connected, False, False, 0)
            elif not network.get("supported"):
                unsupported = Gtk.Label(label="UNSUPPORTED")
                unsupported.get_style_context().add_class("text-warn")
                box.pack_end(unsupported, False, False, 0)
            row.add(box)
            self.network_list.add(row)
        self.network_list.show_all()
        if networks:
            self.set_status("Select a network to continue")
        else:
            self.set_status("No wireless networks were found", "text-warn")

    def on_network_selected(self, _listbox, row):
        self.selected = getattr(row, "_network", None) if row else None
        self.password_entry.set_text("")
        requires_password = bool(
            self.selected
            and self.selected.get("supported")
            and self.selected.get("requires_password")
        )
        self.password_box.set_visible(requires_password)
        if self.selected and not self.selected.get("supported"):
            self.set_status("Enterprise and legacy WEP networks are unavailable in secure quick-connect", "text-warn")
        elif self.selected and self.selected.get("active"):
            self.set_status("This wireless network is already connected", "text-pass")
        elif self.selected:
            self.set_status("Enter the network password" if requires_password else "Ready to connect")
            if requires_password:
                self.password_entry.grab_focus()
        self.update_connect_button()

    def on_network_activated(self, _listbox, row):
        if row is not None:
            self.network_list.select_row(row)
            if self.connect_button.get_sensitive():
                self.begin_connect()

    def update_connect_button(self):
        valid = bool(
            self.selected
            and self.selected.get("supported")
            and not self.selected.get("active")
            and not self.connecting
        )
        if valid and self.selected.get("requires_password"):
            password = self.password_entry.get_text()
            octets = len(password.encode("utf-8"))
            key_mgmt = self.selected.get("key_mgmt")
            if key_mgmt == "wpa-psk":
                valid = 8 <= octets <= 63 or len(password) == 64 and all(char in "0123456789abcdefABCDEF" for char in password)
            elif key_mgmt == "sae":
                valid = 1 <= octets <= 63
            else:
                valid = False
        self.connect_button.set_sensitive(valid)

    def on_response(self, _dialog, response):
        if response == Gtk.ResponseType.HELP:
            self.stop_emission_by_name("response")
            self.refresh_networks()
        elif response == Gtk.ResponseType.APPLY:
            self.stop_emission_by_name("response")
            self.begin_connect()
        elif not self.connecting:
            self.destroy()
        else:
            self.stop_emission_by_name("response")

    def begin_connect(self):
        if not self.connect_button.get_sensitive() or not self.selected:
            return
        password = self.password_entry.get_text()
        self.password_entry.set_text("")
        self.connecting = True
        self.set_deletable(False)
        self.network_list.set_sensitive(False)
        self.rescan_button.set_sensitive(False)
        self.cancel_button.set_sensitive(False)
        self.connect_button.set_sensitive(False)
        self.set_status(f"Connecting to {self.selected.get('ssid', 'wireless network')}…", spinning=True)
        self.parent_pilot.connect_wifi(self.selected, password, self.connection_finished)
        password = ""

    def connection_finished(self, result):
        if not self.get_visible():
            return
        if result.get("ok"):
            self.set_status("Wi-Fi connected. Protection checks are continuing…", "text-pass")
            self.parent_pilot.request_wifi_state()
            GLib.timeout_add(650, self.finish_success)
            return
        self.connecting = False
        self.set_deletable(True)
        self.network_list.set_sensitive(True)
        self.rescan_button.set_sensitive(True)
        self.cancel_button.set_sensitive(True)
        self.set_status(result.get("error", "Unable to connect to this wireless network"), "text-fail")
        self.update_connect_button()

    def finish_success(self):
        if self.get_visible():
            self.destroy()
        return False


class BootPilot(Gtk.Window):
    def __init__(self):
        Gtk.Window.__init__(self, title="PH4NTXM BOOT PILOT")
        self.set_default_size(780, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("ph4ntxm-health")
        self.set_border_width(0)
        self.set_keep_above(True)
        self.set_urgency_hint(True)
        self.set_deletable(False)
        self.set_skip_taskbar_hint(False)
        self.set_skip_pager_hint(True)
        self.set_resizable(True)
        self.settle_deadline = time.monotonic() + 30
        self.boot_settled = False
        self.wifi_request_active = False
        self.wifi_rescan_pending = False
        self.wifi_callbacks = []
        self.auto_wifi_shown = False
        self.wifi_dialog = None
        self.wifi_state = {
            "ok": False,
            "error": "Checking wireless status…",
            "connected": None,
            "networks": [],
        }
        self.header_dot = Gtk.Label(label="●")
        self.header_title = Gtk.Label()
        self.header_subtitle = Gtk.Label()
        self.mode_label = Gtk.Label()
        self.timestamp_label = Gtk.Label()
        self.sections = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        self.build()
        self.refresh()
        GLib.timeout_add_seconds(2, self.boot_refresh)
        GLib.idle_add(self.initial_wifi_refresh)
        GLib.timeout_add_seconds(5, self.periodic_wifi_refresh)

    def build(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(b"""
            window { background: #0d1117; color: #d7e0ea; }
            .top-panel { background: #121a24; padding: 22px; border-bottom: 1px solid #263241; }
            .title { font-size: 26px; font-weight: 700; }
            .subtitle { color: #90a4b8; font-size: 13px; }
            .overall-dot { font-size: 48px; }
            .section { background: #121a24; border: 1px solid #263241; border-radius: 8px; padding: 14px; }
            .section-title { color: #7dcfff; font-size: 13px; font-weight: 700; letter-spacing: 1px; }
            .check-row { padding: 5px 2px; }
            .dot-pass, .dot-ready, .text-pass, .text-ready { color: #44d17a; }
            .dot-warn, .dot-pending, .text-warn, .text-pending { color: #ffb020; }
            .dot-fail, .dot-unsafe, .text-fail, .text-unsafe { color: #ff4d5a; }
            .dot-info, .text-info { color: #7f91a4; }
            .status-pill { background: #1b2633; border-radius: 12px; padding: 5px 10px; }
            .wifi-panel { background: #121a24; border: 1px solid #263241; border-radius: 8px; padding: 13px; }
            .wifi-title { color: #d7e0ea; font-size: 14px; font-weight: 700; }
            .network-list { background: #0d1117; color: #d7e0ea; }
            .network-list row { border-bottom: 1px solid #263241; }
            .network-list row:selected { background: #173047; }
            .footer { background: #0d1117; border-top: 1px solid #263241; padding: 12px 18px; }
            button { padding: 7px 14px; }
        """)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=18)
        top.get_style_context().add_class("top-panel")
        self.header_dot.get_style_context().add_class("overall-dot")
        top.pack_start(self.header_dot, False, False, 0)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.header_title.get_style_context().add_class("title")
        self.header_title.set_halign(Gtk.Align.START)
        self.header_subtitle.get_style_context().add_class("subtitle")
        self.header_subtitle.set_halign(Gtk.Align.START)
        title_box.pack_start(self.header_title, False, False, 0)
        title_box.pack_start(self.header_subtitle, False, False, 0)
        top.pack_start(title_box, True, True, 0)
        meta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        self.mode_label.get_style_context().add_class("status-pill")
        self.timestamp_label.get_style_context().add_class("subtitle")
        meta.pack_start(self.mode_label, False, False, 0)
        meta.pack_start(self.timestamp_label, False, False, 0)
        top.pack_end(meta, False, False, 0)
        root.pack_start(top, False, False, 0)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        viewport = Gtk.Viewport()
        viewport.set_shadow_type(Gtk.ShadowType.NONE)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_border_width(18)
        wifi_panel = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        wifi_panel.get_style_context().add_class("wifi-panel")
        self.wifi_dot = Gtk.Label(label="●")
        self.wifi_dot.get_style_context().add_class("dot-info")
        wifi_panel.pack_start(self.wifi_dot, False, False, 0)
        wifi_labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.wifi_title = Gtk.Label(label="Checking wireless status…")
        self.wifi_title.set_halign(Gtk.Align.START)
        self.wifi_title.get_style_context().add_class("wifi-title")
        wifi_labels.pack_start(self.wifi_title, False, False, 0)
        self.wifi_subtitle = Gtk.Label(label="NetworkManager")
        self.wifi_subtitle.set_halign(Gtk.Align.START)
        self.wifi_subtitle.set_ellipsize(3)
        self.wifi_subtitle.get_style_context().add_class("subtitle")
        wifi_labels.pack_start(self.wifi_subtitle, False, False, 0)
        wifi_panel.pack_start(wifi_labels, True, True, 0)
        self.wifi_button = Gtk.Button(label="Choose network")
        self.wifi_button.set_image(Gtk.Image.new_from_icon_name("network-wireless", Gtk.IconSize.BUTTON))
        self.wifi_button.set_always_show_image(True)
        self.wifi_button.connect("clicked", self.show_wifi_dialog)
        wifi_panel.pack_end(self.wifi_button, False, False, 0)
        content.pack_start(wifi_panel, False, False, 0)
        content.pack_start(self.sections, True, True, 0)
        viewport.add(content)
        scroll.add(viewport)
        root.pack_start(scroll, True, True, 0)
        controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        controls.get_style_context().add_class("footer")
        refresh = Gtk.Button(label="Check again")
        refresh.connect("clicked", self.manual_refresh)
        report = Gtk.Button(label="Detailed report")
        report.connect("clicked", self.open_report)
        mode = read(f"{STATE_DIR}/mode", "unknown")
        if mode == "lonewolf":
            browser_label = "Tor Browser"
            browser_icon = "tor-browser"
        else:
            browser_label = "Firefox ESR"
            browser_icon = "firefox-esr"
        self.browser_button = Gtk.Button(label=browser_label)
        self.browser_button.set_image(Gtk.Image.new_from_icon_name(browser_icon, Gtk.IconSize.BUTTON))
        self.browser_button.set_always_show_image(True)
        self.browser_button.get_style_context().add_class("suggested-action")
        self.browser_button.set_sensitive(False)
        self.browser_button.connect("clicked", self.open_browser)
        controls.pack_end(self.browser_button, False, False, 0)
        self.continue_button = Gtk.Button(label="Continue")
        self.continue_button.set_sensitive(False)
        self.continue_button.connect("clicked", self.continue_session)
        controls.pack_end(self.continue_button, False, False, 0)
        controls.pack_end(refresh, False, False, 0)
        controls.pack_end(report, False, False, 0)
        root.pack_end(controls, False, False, 0)

    def initial_wifi_refresh(self):
        mode = read(f"{STATE_DIR}/mode", "unknown")
        self.request_wifi_state(rescan=mode == "lonewolf")
        return False

    def periodic_wifi_refresh(self):
        self.request_wifi_state()
        return True

    def request_wifi_state(self, rescan=False, callback=None):
        if callback is not None:
            self.wifi_callbacks.append(callback)
        if self.wifi_request_active:
            self.wifi_rescan_pending = self.wifi_rescan_pending or rescan
            return
        self.wifi_request_active = True
        command = [WIFI_CONTROL, "list"]
        if rescan:
            command = [SUDO, "-n", WIFI_CONTROL, "list", "--enable", "--rescan"]

        def worker():
            result = run_json(command, timeout=18)
            GLib.idle_add(self.apply_wifi_state, result)

        threading.Thread(target=worker, name="ph4ntxm-wifi-state", daemon=True).start()

    def apply_wifi_state(self, state):
        self.wifi_request_active = False
        self.wifi_state = state
        self.update_wifi_panel()
        if self.wifi_rescan_pending:
            self.wifi_rescan_pending = False
            self.request_wifi_state(rescan=True)
            return False
        callbacks = self.wifi_callbacks
        self.wifi_callbacks = []
        for callback in callbacks:
            try:
                callback(state)
            except Exception:
                continue
        mode = read(f"{STATE_DIR}/mode", "unknown")
        if (
            mode == "lonewolf"
            and not self.auto_wifi_shown
            and state.get("ok")
            and state.get("hardware_enabled")
            and state.get("device_count", 0) > 0
            and not state.get("connected")
        ):
            self.auto_wifi_shown = True
            GLib.timeout_add(250, self.show_wifi_dialog)
        return False

    def update_wifi_panel(self):
        state = self.wifi_state
        connected = state.get("connected") if state.get("ok") else None
        context = self.wifi_dot.get_style_context()
        for css_class in ("dot-info", "dot-pass", "dot-warn", "dot-fail"):
            context.remove_class(css_class)
        if connected:
            context.add_class("dot-pass")
            self.wifi_title.set_text(f"Connected to {connected.get('ssid', 'Wi-Fi')}")
            detail = f"{connected.get('security', 'Wireless')}  •  {connected.get('strength', 0)}% signal"
            if read(f"{STATE_DIR}/mode", "unknown") == "lonewolf" and not tor_ready():
                detail += "  •  Tor bootstrapping"
            self.wifi_subtitle.set_text(detail)
            self.wifi_button.set_label("Change network")
            self.wifi_button.set_sensitive(True)
        elif not state.get("ok"):
            context.add_class("dot-fail")
            self.wifi_title.set_text("Wireless status unavailable")
            self.wifi_subtitle.set_text(state.get("error", "NetworkManager is unavailable"))
            self.wifi_button.set_label("Try again")
            self.wifi_button.set_sensitive(True)
        elif not state.get("hardware_enabled"):
            context.add_class("dot-fail")
            self.wifi_title.set_text("Wireless radio blocked")
            self.wifi_subtitle.set_text("Enable the hardware wireless switch to continue")
            self.wifi_button.set_label("Choose network")
            self.wifi_button.set_sensitive(False)
        elif not state.get("device_count"):
            context.add_class("dot-info")
            self.wifi_title.set_text("No wireless adapter")
            self.wifi_subtitle.set_text("Connect a supported Wi-Fi adapter to use wireless networking")
            self.wifi_button.set_label("Choose network")
            self.wifi_button.set_sensitive(False)
        elif not state.get("enabled"):
            context.add_class("dot-warn")
            self.wifi_title.set_text("Wi-Fi radio is off")
            self.wifi_subtitle.set_text("Open wireless networks to enable it for this session")
            self.wifi_button.set_label("Turn on & choose")
            self.wifi_button.set_sensitive(True)
        else:
            context.add_class("dot-warn")
            self.wifi_title.set_text("Wi-Fi not connected")
            self.wifi_subtitle.set_text("Choose a network to begin protected connectivity")
            self.wifi_button.set_label("Choose network")
            self.wifi_button.set_sensitive(True)

    def show_wifi_dialog(self, _widget=None):
        if self.wifi_dialog is not None and self.wifi_dialog.get_visible():
            self.wifi_dialog.present()
            return False
        automatic = _widget is None
        self.wifi_dialog = WifiDialog(self)
        self.wifi_dialog.connect("destroy", self.wifi_dialog_closed)
        self.wifi_dialog.show_all()
        self.wifi_dialog.password_box.hide()
        if automatic and self.wifi_state.get("ok"):
            self.wifi_dialog.populate(self.wifi_state)
        else:
            self.wifi_dialog.refresh_networks()
        return False

    def wifi_dialog_closed(self, _dialog):
        self.wifi_dialog = None

    def connect_wifi(self, network, password, callback):
        request = {
            "device": network.get("device", ""),
            "access_point": network.get("access_point", ""),
            "ssid_id": network.get("ssid_id", ""),
            "bssid": network.get("bssid", ""),
            "key_mgmt": network.get("key_mgmt", ""),
            "password": password,
        }
        input_data = json.dumps(request, ensure_ascii=False, separators=(",", ":"))
        request["password"] = ""
        password = ""

        def worker(payload=input_data):
            result = run_json(
                [SUDO, "-n", WIFI_CONTROL, "connect"],
                timeout=42,
                input_data=payload,
            )
            GLib.idle_add(callback, result)

        threading.Thread(target=worker, name="ph4ntxm-wifi-connect", daemon=True).start()
        input_data = ""

    def manual_refresh(self, _button=None):
        self.refresh()
        self.request_wifi_state()

    def continue_session(self, _button=None):
        self.refresh()
        if self.boot_settled:
            self.destroy()

    def open_report(self, _):
        try:
            subprocess.Popen([
                "/usr/bin/xfce4-terminal",
                "--disable-server",
                "--class=PH4NTXM-Health",
                "--title=PH4NTXM Health Report",
                "--hold",
                "--command=/usr/local/bin/ph4ntxm-health",
            ])
        except OSError:
            pass

    def open_browser(self, _):
        self.refresh()
        if not self.boot_settled:
            return
        mode = read(f"{STATE_DIR}/mode", "unknown")
        if mode == "lonewolf":
            command = ["/usr/local/bin/ph4ntxm-tor-browser"]
        elif mode in {"linux", "windows"}:
            command = ["/usr/bin/firefox-esr"]
        else:
            return
        try:
            subprocess.Popen(command)
        except OSError:
            return
        self.destroy()

    def boot_refresh(self):
        self.refresh()
        return True

    def refresh(self):
        groups = collect()
        state, title, subtitle = overall(groups)
        self.boot_settled = state == "ready"
        waiting = not self.boot_settled and time.monotonic() < self.settle_deadline
        if waiting:
            failed = sum(
                check["state"] == "fail" and check["critical"]
                for group in groups
                for check in group["checks"]
            )
            state = "warn"
            title = "VERIFYING BOOT"
            subtitle = f"Waiting for {failed} protection gate{'s' if failed != 1 else ''} to settle"
            for group in groups:
                for check in group["checks"]:
                    if check["state"] == "fail":
                        check["state"] = "pending"
                        check["detail"] = "INACTIVE"
        elif self.boot_settled:
            title = "BOOT READY"
        self.browser_button.set_sensitive(self.boot_settled)
        self.continue_button.set_sensitive(self.boot_settled)
        context = self.header_dot.get_style_context()
        for css_class in ("dot-ready", "dot-warn", "dot-unsafe"):
            context.remove_class(css_class)
        context.add_class(f"dot-{state}")
        self.header_title.set_text(title)
        self.header_subtitle.set_text(subtitle)
        mode = read(f"{STATE_DIR}/mode", "unknown").upper()
        self.mode_label.set_text(f"MODE  {mode}")
        self.timestamp_label.set_text(time.strftime("Updated %H:%M:%S"))
        for child in self.sections.get_children():
            self.sections.remove(child)
        for group in groups:
            panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            panel.get_style_context().add_class("section")
            checks = group["checks"]
            group_fail = any(check["state"] == "fail" for check in checks)
            group_warn = any(check["state"] == "warn" for check in checks)
            group_pending = any(check["state"] == "pending" for check in checks)
            marker = "●"
            marker_class = "dot-fail" if group_fail else "dot-warn" if group_warn or group_pending else "dot-pass"
            heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            dot = Gtk.Label(label=marker)
            dot.get_style_context().add_class(marker_class)
            heading.pack_start(dot, False, False, 0)
            name = Gtk.Label(label=group["name"])
            name.set_halign(Gtk.Align.START)
            name.get_style_context().add_class("section-title")
            heading.pack_start(name, True, True, 0)
            passed = sum(check["state"] == "pass" for check in checks)
            count = Gtk.Label(label=f"{passed}/{len(checks)}")
            count.get_style_context().add_class("subtitle")
            heading.pack_end(count, False, False, 0)
            panel.pack_start(heading, False, False, 2)
            panel.pack_start(Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL), False, False, 5)
            for check in checks:
                panel.pack_start(IndicatorRow(check), False, False, 0)
            self.sections.pack_start(panel, False, False, 0)
        self.sections.show_all()
        return not self.boot_settled


def main():
    window = BootPilot()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
