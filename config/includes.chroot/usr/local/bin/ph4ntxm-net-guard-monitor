import signal
import sys
import threading
import time

sys.path.insert(0, '/usr/lib/ph4ntxm')
from net_guard_client import BoundedProcess, HelperCall

import gi

gi.require_version('Gio', '2.0')
from gi.repository import Gio, GLib

GUI = '/usr/local/bin/ph4ntxm-net-guard'
NOTIFICATION = ['/usr/bin/notify-send', '--app-name=PH4NTXM Net Guard', '--icon=ph4ntxm-net-guard',
                '--urgency=normal', '--transient', '--expire-time=8000', '--action=open=Open Net Guard',
                '--wait', '--', 'Network access blocked',
                'Open Net Guard to review requests from running processes.']


def pending_requests(snapshot):
    if not snapshot['enabled'] or snapshot['state'] != 'on' or not snapshot['generation']:
        return set()
    return {(snapshot['generation'], item['request_id']) for item in snapshot['requests'] if not item['approved']}


class NotificationCall(BoundedProcess):
    def __init__(self, requests):
        super().__init__()
        self.requests = set(requests)

    def run(self):
        try:
            code, output = self.run_process(NOTIFICATION, 20, maximum=32)
            action = output.strip()
            return {'ok': code == 0 and action in {b'', b'open'}, 'open': code == 0 and action == b'open'}
        except Exception:
            return {'ok': False, 'open': False}


class NetGuardMonitor:
    def __init__(self, application):
        self.application = application
        self.stopping = False
        self.quitting = False
        self.snapshot_job = None
        self.notification_job = None
        self.current = None
        self.notified = set()
        self.next_notification = 0
        self.poll_source = GLib.timeout_add_seconds(8, self.poll)
        self.initial_source = GLib.idle_add(self.initial_poll)

    def initial_poll(self):
        self.initial_source = 0
        self.poll()
        return False

    def start(self, job, callback):
        def worker():
            try:
                result = job.run()
            except Exception:
                result = {'ok': False}
            GLib.idle_add(callback, job, result)
        try:
            threading.Thread(target=worker, daemon=False).start()
        except (RuntimeError, OSError):
            callback(job, {'ok': False})

    def poll(self):
        if self.stopping:
            return False
        if self.snapshot_job is None:
            self.snapshot_job = HelperCall('snapshot')
            self.start(self.snapshot_job, self.finish_snapshot)
        return True

    def finish_snapshot(self, job, result):
        if self.snapshot_job is not job:
            return False
        self.snapshot_job = None
        if self.stopping:
            self.maybe_quit()
            return False
        if result.get('ok') is not True:
            self.current = None
            return False
        self.current = pending_requests(result)
        self.notified.intersection_update(self.current)
        self.show_notification()
        return False

    def show_notification(self):
        if self.stopping or self.current is None or self.notification_job is not None:
            return
        pending = self.current - self.notified
        if pending and time.monotonic() >= self.next_notification:
            self.next_notification = time.monotonic() + 30
            self.notification_job = NotificationCall(pending)
            self.start(self.notification_job, self.finish_notification)

    def finish_notification(self, job, result):
        if self.notification_job is not job:
            return False
        self.notification_job = None
        if self.stopping:
            self.maybe_quit()
            return False
        if result.get('ok') is True:
            self.notified.update(job.requests)
            if self.current is not None:
                self.notified.intersection_update(self.current)
            if result.get('open') is True:
                try:
                    pid, _, _, _ = GLib.spawn_async([GUI], flags=GLib.SpawnFlags.DEFAULT)
                    GLib.spawn_close_pid(pid)
                except GLib.Error:
                    pass
        self.show_notification()
        return False

    def close(self, *_):
        if not self.stopping:
            self.stopping = True
            for name in ('poll_source', 'initial_source'):
                source = getattr(self, name, 0)
                if source:
                    GLib.source_remove(source)
                    setattr(self, name, 0)
            for job in (self.snapshot_job, self.notification_job):
                if job is not None:
                    job.cancel()
        self.maybe_quit()

    def maybe_quit(self):
        if self.stopping and self.snapshot_job is None and self.notification_job is None and not self.quitting:
            self.quitting = True
            self.application.quit()


def main():
    application = Gio.Application(application_id='org.ph4ntxm.NetGuardMonitor')
    monitor = None
    def activate(current):
        nonlocal monitor
        if monitor is None:
            current.hold()
            monitor = NetGuardMonitor(current)
            signal.signal(signal.SIGTERM, monitor.close)
            signal.signal(signal.SIGINT, monitor.close)
            current.connect('shutdown', monitor.close)
    application.connect('activate', activate)
    return application.run(sys.argv)


if __name__ == '__main__':
    raise SystemExit(main())
