import os
import sys
import threading

sys.path.insert(0, "/usr/lib/ph4ntxm")
from net_guard_client import HelperCall, display_text

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango

CSS_FILE = "/usr/share/ph4ntxm/ph4ntxm-ui.css"
ICON = "ph4ntxm-net-guard"
STATUS = {
    "off": ("Protection off", "status-disabled"),
    "on": ("Protection enabled", "status-active"),
    "attention": ("Protection needs attention", "status-danger"),
}
MODE_LABELS = {"linux": "Linux", "windows": "Windows", "lonewolf": "Lone Wolf"}


def add_class(widget, name):
    widget.get_style_context().add_class(name)
    return widget


def label(text, style=None):
    widget = Gtk.Label(label=text, xalign=0)
    widget.set_line_wrap(True)
    widget.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    widget.set_max_width_chars(94)
    return add_class(widget, style) if style else widget


class NetGuardWindow(Gtk.ApplicationWindow):
    def __init__(self, application):
        super().__init__(application=application, title="PH4NTXM Net Guard")
        width, height = 900, 600
        display = Gdk.Display.get_default()
        monitor = (
            (display.get_primary_monitor() or display.get_monitor(0))
            if display
            else None
        )
        if monitor:
            area = monitor.get_workarea()
            width, height = min(width, max(480, area.width - 40)), min(
                height, max(360, area.height - 40)
            )
        self.set_default_size(width, height)
        self.set_size_request(min(640, width), min(420, height))
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name(ICON)
        self.set_wmclass("ph4ntxm-net-guard", "PH4NTXM Net Guard")
        if os.path.isfile(CSS_FILE):
            provider = Gtk.CssProvider()
            provider.load_from_path(CSS_FILE)
            Gtk.StyleContext.add_provider_for_screen(
                self.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
        add_class(self, "ph4ntxm-window")
        self.snapshot = None
        self.generation = None
        self.requests = {}
        self.acknowledged = set()
        self.snapshot_job = None
        self.action_job = None
        self.confirming = False
        self.closed = False
        self.connect("delete-event", self.on_close)
        self.connect("destroy", self.on_destroy)
        self.build()
        self.poll_source = GLib.timeout_add_seconds(3, self.poll)
        self.initial_source = GLib.idle_add(self.initial_refresh)

    def build(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(root)
        header = add_class(Gtk.Box(spacing=16), "top-panel")
        headings = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        headings.pack_start(label("PH4NTXM Net Guard", "title"), False, False, 0)
        headings.pack_start(
            label("Network approval for running processes", "subtitle"), False, False, 0
        )
        header.pack_start(headings, True, True, 0)
        try:
            with open("/run/ph4ntxm/mode", encoding="ascii") as handle:
                mode = MODE_LABELS.get(handle.read(32).strip())
        except (OSError, UnicodeError):
            mode = None
        pill = add_class(
            Gtk.Label(label="Mode " + mode if mode else "Mode unavailable"),
            "status-pill",
        )
        pill.set_valign(Gtk.Align.CENTER)
        header.pack_end(pill, False, False, 0)
        root.pack_start(header, False, False, 0)
        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        content.set_border_width(16)
        body_scroll = Gtk.ScrolledWindow()
        body_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        body_scroll.add(content)
        root.pack_start(body_scroll, True, True, 0)
        status = add_class(Gtk.Box(spacing=12), "section")
        summary = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.status_label = label("Checking protection", "section-title")
        self.status_message = label("Reading Net Guard status…", "subtitle")
        summary.pack_start(self.status_label, False, False, 0)
        summary.pack_start(self.status_message, False, False, 0)
        status.pack_start(summary, True, True, 0)
        self.protection_button = Gtk.Button(label="Enable Protection")
        self.protection_button.set_valign(Gtk.Align.CENTER)
        self.protection_button.connect("clicked", self.on_protection)
        status.pack_end(self.protection_button, False, False, 0)
        content.pack_start(status, False, False, 0)
        content.pack_start(
            label(
                "Each approval covers one process execution. Helper processes may need separate approval. Retry or reconnect after approval.",
                "subtitle",
            ),
            False,
            False,
            0,
        )
        self.store = Gtk.ListStore(str, str, str, str, str, str, str)
        self.tree = Gtk.TreeView(model=self.store)
        self.tree.set_enable_search(False)
        for heading, position, minimum, expand in [
            ("Application", 1, 140, True),
            ("Executable", 2, 170, True),
            ("Destination", 3, 150, True),
            ("Port", 4, 55, False),
            ("Protocol", 5, 70, False),
            ("State", 6, 100, False),
        ]:
            renderer = Gtk.CellRendererText()
            renderer.set_property("ellipsize", Pango.EllipsizeMode.END)
            column = Gtk.TreeViewColumn(heading, renderer, text=position)
            column.set_min_width(minimum)
            column.set_expand(expand)
            column.set_resizable(True)
            self.tree.append_column(column)
        self.tree.get_selection().connect("changed", self.on_selection)
        self.scroll = Gtk.ScrolledWindow()
        self.scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.scroll.set_min_content_height(80)
        self.scroll.add(self.tree)
        content.pack_start(self.scroll, True, True, 0)
        self.overflow_label = label("", "status-warning")
        content.pack_start(self.overflow_label, False, False, 0)
        self.details = label(
            "Select a request to review its process and destination.", "subtitle"
        )
        self.details.set_selectable(True)
        self.details.set_lines(3)
        self.details.set_ellipsize(Pango.EllipsizeMode.END)
        content.pack_start(self.details, False, False, 0)
        actions = Gtk.Box(spacing=10)
        self.keep_button = Gtk.Button(label="Keep Blocked")
        self.keep_button.connect("clicked", self.on_keep_blocked)
        self.allow_button = add_class(
            Gtk.Button(label="Allow Process for This Run"), "primary"
        )
        self.allow_button.connect("clicked", self.on_allow)
        actions.pack_end(self.allow_button, False, False, 0)
        actions.pack_end(self.keep_button, False, False, 0)
        content.pack_start(actions, False, False, 0)
        content.pack_start(
            label(
                "Every Enable, Allow and Disable requires your password. Closing this window leaves protection running; an action already started may still complete.",
                "subtitle",
            ),
            False,
            False,
            0,
        )
        footer = Gtk.Box(spacing=10)
        self.spinner = Gtk.Spinner()
        footer.pack_start(self.spinner, False, False, 0)
        self.notice = label("", "subtitle")
        footer.pack_start(self.notice, True, True, 0)
        close = Gtk.Button(label="Close")
        close.connect("clicked", self.on_close)
        self.refresh_button = Gtk.Button(label="Refresh")
        self.refresh_button.connect("clicked", self.refresh)
        footer.pack_end(close, False, False, 0)
        footer.pack_end(self.refresh_button, False, False, 0)
        content.pack_start(footer, False, False, 0)
        self.update_controls()

    def selected_request(self):
        model, iterator = self.tree.get_selection().get_selected()
        return self.requests.get(model[iterator][0]) if iterator is not None else None

    def request_key(self, item):
        return (
            (self.snapshot["generation"], item["request_id"])
            if self.snapshot and item
            else None
        )

    def row_values(self, item):
        state = (
            "Approved"
            if item["approved"]
            else (
                "Kept blocked"
                if self.request_key(item) in self.acknowledged
                else "Blocked"
            )
        )
        return (
            item["request_id"],
            item["app_name"],
            item["executable"] or "Unavailable",
            item["destination"] or "Unavailable",
            str(item["port"]) if item["port"] else "—",
            item["protocol"].upper(),
            state,
        )

    def update_controls(self):
        item = self.selected_request()
        idle = self.action_job is None and not self.confirming and not self.closed
        ready = bool(
            self.snapshot
            and self.snapshot["state"] == "on"
            and self.snapshot["enabled"]
        )
        self.protection_button.set_sensitive(idle and self.snapshot is not None)
        self.refresh_button.set_sensitive(not self.closed and self.snapshot_job is None)
        self.allow_button.set_sensitive(
            bool(
                idle
                and ready
                and item
                and not item["approved"]
                and item["approval_available"]
            )
        )
        self.keep_button.set_sensitive(
            bool(
                idle
                and item
                and not item["approved"]
                and self.request_key(item) not in self.acknowledged
            )
        )
        self.keep_button.set_label(
            "Kept Blocked"
            if item and self.request_key(item) in self.acknowledged
            else "Keep Blocked"
        )
        if self.snapshot_job is not None or self.action_job is not None:
            self.spinner.start()
        else:
            self.spinner.stop()

    def on_selection(self, *_):
        item = self.selected_request()
        if item:
            text = f"{item['app_name']} · PID {item['pid']} · {item['executable'] or 'Executable unavailable'}\n{item['destination'] or 'Destination unavailable'} · Port {item['port'] or 'unavailable'} · {item['protocol'].upper()}"
            if item["reason"]:
                text += "\n" + item["reason"]
            self.details.set_text(text)
            self.details.set_tooltip_text(text)
        else:
            self.details.set_text(
                "Select a request to review its process and destination."
            )
            self.details.set_tooltip_text(None)
        self.update_controls()

    def apply_snapshot(self, snapshot):
        if self.generation != snapshot["generation"]:
            self.tree.get_selection().unselect_all()
            self.store.clear()
            self.acknowledged.clear()
        self.generation = snapshot["generation"]
        self.snapshot = snapshot
        self.requests = {item["request_id"]: item for item in snapshot["requests"]}
        self.acknowledged.intersection_update(
            {self.request_key(item) for item in snapshot["requests"]}
        )
        existing = set()
        iterator = self.store.get_iter_first()
        while iterator is not None:
            current = iterator
            iterator = self.store.iter_next(current)
            request_id = self.store[current][0]
            item = self.requests.get(request_id)
            if item is None:
                self.store.remove(current)
            else:
                values = self.row_values(item)
                if tuple(self.store[current]) != values:
                    self.store.set(
                        current,
                        *(value for pair in enumerate(values) for value in pair),
                    )
                existing.add(request_id)
        for item in snapshot["requests"]:
            if item["request_id"] not in existing:
                self.store.append(self.row_values(item))
        title, style = STATUS[snapshot["state"]]
        self.set_status(title, style)
        self.status_message.set_text(snapshot["message"])
        self.protection_button.set_label(
            "Disable Protection" if snapshot["enabled"] else "Enable Protection"
        )
        overflow = snapshot["overflow"]
        self.overflow_label.set_text(
            f"{overflow} additional requests could not be recorded. Unapproved processes remain blocked."
            if overflow
            else ""
        )
        self.on_selection()

    def set_status(self, title, style):
        self.status_label.set_text(title)
        context = self.status_label.get_style_context()
        for name in (
            "status-disabled",
            "status-active",
            "status-warning",
            "status-danger",
        ):
            context.remove_class(name)
        context.add_class(style)

    def start_job(self, job, callback):
        application = self.get_application()
        application.hold()

        def finish(result):
            try:
                if not self.closed:
                    callback(job, result)
            finally:
                application.release()
            return False

        def worker():
            try:
                result = job.run()
            except Exception:
                result = {
                    "ok": False,
                    "error": "Net Guard could not complete the request.",
                }
            GLib.idle_add(finish, result)

        try:
            threading.Thread(target=worker, daemon=False).start()
        except (RuntimeError, OSError):
            finish({"ok": False, "error": "Net Guard request could not start."})

    def refresh(self, *_):
        if self.closed or self.snapshot_job is not None:
            return False
        self.snapshot_job = HelperCall("snapshot")
        self.update_controls()
        self.start_job(self.snapshot_job, self.finish_snapshot)
        return False

    def finish_snapshot(self, job, result):
        if self.snapshot_job is not job:
            return
        self.snapshot_job = None
        if "state" in result:
            self.apply_snapshot(result)
        else:
            self.snapshot = None
            self.requests = {}
            self.store.clear()
            self.set_status("Protection status unavailable", "status-warning")
            self.status_message.set_text(
                display_text(
                    result.get("error")
                    or "Refresh to check the current protection state."
                )
            )
            self.overflow_label.set_text("")
            self.on_selection()
        self.update_controls()

    def begin_action(self, action, payload=None):
        if self.action_job is not None or self.closed:
            return
        if self.snapshot_job is not None:
            self.snapshot_job.cancel()
            self.snapshot_job = None
        self.action_job = HelperCall(action, payload)
        self.notice.set_text("Enter your session password to authorize this action…")
        self.update_controls()
        self.start_job(self.action_job, self.finish_action)

    def finish_action(self, job, result):
        if self.action_job is not job:
            return
        self.action_job = None
        if self.snapshot_job is not None:
            self.snapshot_job.cancel()
            self.snapshot_job = None
        if result.get("ok") is True:
            self.apply_snapshot(result)
            if job.action == "allow":
                approved = result["generation"] == job.payload["generation"] and any(
                    item["request_id"] == job.payload["request_id"] and item["approved"]
                    for item in result["requests"]
                )
                self.notice.set_text(
                    "Process approved for this run. Retry or reconnect; helper processes may need separate approval."
                    if approved
                    else "The process changed or exited before its approval could be confirmed."
                )
            elif job.action == "enable":
                self.notice.set_text(
                    "Protection enabled. Existing connections need to reconnect, and each process needs fresh approval."
                    if result["state"] == "on"
                    else "Check the protection status before retrying connections."
                )
            else:
                self.notice.set_text(
                    "Protection disabled. Temporary approvals have ended."
                    if result["state"] == "off"
                    else "Check the protection status; disabling could not be confirmed."
                )
        else:
            if "state" in result:
                self.apply_snapshot(result)
            self.notice.set_text(
                display_text(
                    result.get("error")
                    or result.get("message")
                    or "Net Guard could not complete the action."
                )
            )
        self.update_controls()
        self.refresh()

    def initial_refresh(self):
        self.initial_source = 0
        return self.refresh()

    def poll(self):
        if self.closed:
            return False
        self.refresh()
        return True

    def on_protection(self, *_):
        if self.snapshot is None or self.action_job is not None or self.confirming:
            return
        if self.snapshot["enabled"]:
            self.begin_action("disable")
            return
        self.confirming = True
        self.update_controls()
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            destroy_with_parent=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE,
            text="Enable strict network approval?",
        )
        dialog.format_secondary_text(
            "Enabling interrupts existing app connections. Processes must retry or reconnect and receive fresh approval. Each approval covers one process execution; helper processes may need separate approval. You will enter your password next."
        )
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dialog.add_button("Enable Protection", Gtk.ResponseType.OK)
        action_area = dialog.get_action_area()
        action_area.set_layout(Gtk.ButtonBoxStyle.END)
        action_area.get_style_context().remove_class("linked")
        action_area.set_border_width(12)
        for button in action_area.get_children():
            action_area.set_child_non_homogeneous(button, True)
            button.set_halign(Gtk.Align.END)
        dialog.set_default_response(Gtk.ResponseType.CANCEL)
        response = dialog.run()
        dialog.destroy()
        self.confirming = False
        self.update_controls()
        if response == Gtk.ResponseType.OK and not self.closed:
            self.begin_action("enable")

    def on_allow(self, *_):
        item = self.selected_request()
        if (
            self.snapshot
            and self.snapshot["state"] == "on"
            and self.snapshot["enabled"]
            and item
            and not item["approved"]
            and item["approval_available"]
        ):
            self.begin_action(
                "allow",
                {
                    "generation": self.snapshot["generation"],
                    "request_id": item["request_id"],
                },
            )

    def on_keep_blocked(self, *_):
        item = self.selected_request()
        if item and not item["approved"] and self.action_job is None:
            self.acknowledged.add(self.request_key(item))
            self.notice.set_text(
                "Request acknowledged. This process stays blocked; no approval was granted."
            )
            self.apply_snapshot(self.snapshot)

    def on_close(self, *_):
        self.destroy()
        return True

    def on_destroy(self, *_):
        if self.closed:
            return
        self.closed = True
        for name in ("poll_source", "initial_source"):
            source = getattr(self, name, 0)
            if source:
                GLib.source_remove(source)
                setattr(self, name, 0)
        if self.snapshot_job is not None:
            self.snapshot_job.cancel()


class NetGuardApplication(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="org.ph4ntxm.NetGuard", flags=Gio.ApplicationFlags.FLAGS_NONE
        )
        self.window = None

    def do_activate(self):
        if self.window is None or self.window.closed:
            self.window = NetGuardWindow(self)
        self.window.show_all()
        self.window.present()


def main():
    return NetGuardApplication().run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
