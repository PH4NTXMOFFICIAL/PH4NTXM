[Desktop Entry]
Type=Application
Name=PH4NTXM Image Viewer
Comment=Open local images in a disposable offline sandbox
Exec=/usr/local/bin/ph4ntxm-media --kind image -- %F
Icon=ph4ntxm-image-viewer
Terminal=false
MimeType=image/png;image/jpeg;image/gif;image/bmp;image/x-xpixmap;image/tiff;image/svg+xml;image/svg+xml-compressed;image/webp;image/x-icon;image/vnd.microsoft.icon;image/x-icns;image/x-tga;image/x-xbitmap;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-quicktime;application/x-navi-animation;
Categories=Graphics;Viewer;X-PH4NTXMApps;
StartupNotify=false
