[Desktop Entry]
Type=Application
Name=MAC Changer
Comment=Show MAC Changer help inside a terminal
Exec=xfce4-terminal --disable-server --class=MAC-Changer --title="MAC Changer" --hold -e "zsh -c 'echo -e \"\033[38;2;0;171;255m[+] Review MAC Changer options.\033[0m\"; macchanger --help; exec zsh'"
StartupWMClass=MAC-Changer
Icon=ph4ntxm-macchanger
Terminal=false
Categories=X-AnonymityPH4NTXM;
