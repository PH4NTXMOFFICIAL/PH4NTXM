[Desktop Entry]
Type=Application
Name=Tor
Comment=Show Tor help inside a terminal
Exec=xfce4-terminal --disable-server --class=Tor --title="Tor" --hold -e "zsh -c 'echo -e \"\033[38;2;0;171;255m[+] Review Tor options.\033[0m\"; tor --help; exec zsh'"
StartupWMClass=Tor
Icon=ph4ntxm-tor
Terminal=false
Categories=X-AnonymityPH4NTXM;
