[Desktop Entry]
Type=Application
Name=PH4NTXM Media Player
Comment=Open local media in a disposable offline sandbox
Exec=/usr/local/bin/ph4ntxm-media --kind video -- %F
Icon=ph4ntxm-video-viewer
Terminal=false
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/mpeg;video/mp2t;video/ogg;video/x-flv;video/x-ms-wmv;audio/mpeg;audio/mp4;audio/flac;audio/ogg;audio/x-wav;application/ogg;
Categories=AudioVideo;Player;X-PH4NTXMApps;
StartupNotify=false
