#!/bin/sh
set -e
export DEBIAN_FRONTEND=noninteractive

apt-mark manual \
  linux-image-amd64 \
  live-boot \
  live-config \
  live-config-systemd \
  systemd-sysv \
  sudo \
  util-linux \
  bsdextrautils \
  procps \
  kmod \
  iproute2 \
  adjtimex \
  kexec-tools \
  busybox \
  cpio \
  firmware-linux \
  firmware-linux-free \
  firmware-linux-nonfree \
  firmware-misc-nonfree \
  firmware-iwlwifi \
  firmware-brcm80211 \
  firmware-realtek \
  firmware-atheros \
  wireless-regdb \
  iw \
  wpasupplicant \
  isc-dhcp-client \
  network-manager \
  network-manager-gnome \
  modemmanager \
  rfkill \
  ndctl \
  nftables \
  conntrack \
  fail2ban \
  cryptsetup \
  secure-delete \
  tor \
  dnsmasq-base \
  proxychains4 \
  wireguard-tools \
  onionshare \
  macchanger \
  unbound \
  exiftool \
  nmap \
  masscan \
  dnsutils \
  whois \
  traceroute \
  nikto \
  dirb \
  gobuster \
  whatweb \
  wfuzz \
  sqlmap \
  hydra \
  john \
  hashcat \
  crunch \
  aircrack-ng \
  tcpdump \
  wireshark \
  netcat-openbsd \
  arp-scan \
  binwalk \
  file \
  python3 \
  python3-gi \
  python3-dbus \
  python3-scapy \
  python3-netfilterqueue \
  python3-pip \
  python3-setuptools \
  python3-wheel \
  libnetfilter-queue1 \
  libbpf1 \
  gcc \
  libc6-dev \
  openjdk-21-jre \
  jq \
  curl \
  git \
  ruby \
  ruby-dev \
  ruby-bundler \
  build-essential \
  libpq-dev \
  libsqlite3-dev \
  zlib1g-dev \
  libxml2-dev \
  libxslt1-dev \
  libpcap-dev \
  libyaml-dev \
  libffi-dev \
  libreadline-dev \
  libssl-dev \
  docker.io \
  zsh \
  gir1.2-ayatanaappindicator3-0.1 \
  gir1.2-gtk-3.0 \
  libnotify-bin \
  gnome-themes-extra \
  task-xfce-desktop \
  lightdm \
  lightdm-gtk-greeter \
  xfce4-goodies \
  firefox-esr \
  gnupg \
  xz-utils \
  hdparm \
  fontconfig \
  fontconfig-config \
  libfreetype6 \
  libpango-1.0-0 \
  libharfbuzz0b \
  fonts-dejavu-core \
  ttf-mscorefonts-installer \
  locales \
  libvte-2.91-0 \
  ncurses-term \
  console-setup \
  locales-all \
  binutils \
|| true

apt-get autoremove -y --purge || true
apt-get clean || true
rm -rf /var/lib/apt/lists/*
rm -rf /var/lib/man-db/*
