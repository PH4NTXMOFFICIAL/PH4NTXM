#!/usr/bin/env bash
set -euo pipefail

REAL_PATH="/usr/bin/firefox-esr"

if [[ ! -f "${REAL_PATH}-real" ]]; then
    dpkg-divert --add --rename --divert "${REAL_PATH}-real" "$REAL_PATH"
fi

cat <<EOF > "$REAL_PATH"
#!/usr/bin/env bash
set -euo pipefail

STATE_DIR="/run/ph4ntxm"
REAL_BROWSER="/usr/bin/firefox-esr-real"
MODE_FILE="\$STATE_DIR/mode"

[[ -f "\$MODE_FILE" && ! -L "\$MODE_FILE" && "\$(stat -c '%u' "\$MODE_FILE")" == 0 ]] || {
    printf 'firefox-esr: PH4NTXM mode is not initialized\\n' >&2
    exit 1
}
mode_permissions=\$(stat -c '%a' "\$MODE_FILE")
[[ "\$mode_permissions" =~ ^[0-7]{3,4}\$ ]] || exit 1
(( (8#\$mode_permissions & 0022) == 0 )) || exit 1
MODE=\$(tr -d '\\n' < "\$MODE_FILE")
case "\$MODE" in
    lonewolf)
        exec /usr/local/bin/ph4ntxm-tor-browser "\$@"
        ;;
    linux|windows) ;;
    *)
        printf 'firefox-esr: invalid PH4NTXM mode\\n' >&2
        exit 1
        ;;
esac

RUNTIME_BASE="/run/user/\$(id -u)"
PROFILE_DIR="\$RUNTIME_BASE/ph4ntxm-firefox-profile"
FONT_DIR="\$STATE_DIR/fonts-active"
FONT_CONF="\$FONT_DIR/fonts.conf"

umask 077
if [[ ! -d "\$RUNTIME_BASE" || ! -O "\$RUNTIME_BASE" ]]; then
    printf 'firefox-esr: private runtime directory is unavailable\\n' >&2
    exit 1
fi
mkdir -p "\$PROFILE_DIR"
chmod 0700 "\$PROFILE_DIR"
exec 9>"\$RUNTIME_BASE/ph4ntxm-firefox.lock"
if ! flock -n 9; then
    printf 'firefox-esr: PH4NTXM browser session is already active\n' >&2
    exit 1
fi

[[ -x "\$REAL_BROWSER" ]] || {
    printf 'firefox-esr: diverted browser executable is unavailable\\n' >&2
    exit 1
}
version_output=\$("\$REAL_BROWSER" --version 2>/dev/null || true)
if [[ "\$version_output" =~ ([0-9]+)([.][0-9]+)+ ]]; then
    FIREFOX_MAJOR="\${BASH_REMATCH[1]}"
else
    printf 'firefox-esr: unable to determine browser version\\n' >&2
    exit 1
fi

for state_file in "\$STATE_DIR/browser_env" "\$STATE_DIR/cores_env" "\$STATE_DIR/gpu_env"; do
    [[ -f "\$state_file" && ! -L "\$state_file" && -r "\$state_file" ]] || {
        printf 'firefox-esr: required PH4NTXM browser state is unavailable\\n' >&2
        exit 1
    }
    owner=\$(stat -c '%u' "\$state_file")
    permissions=\$(stat -c '%a' "\$state_file")
    if [[ "\$owner" != 0 ]] || (( (8#\$permissions & 022) != 0 )); then
        printf 'firefox-esr: unsafe PH4NTXM browser state permissions\\n' >&2
        exit 1
    fi
    source "\$state_file"
done

[[ "\${PH4_DEVICE_PIXEL_RATIO:-}" =~ ^[0-9]+([.][0-9]+)?\$ ]] || exit 1
[[ "\${PH4_REPORTED_CORES:-}" =~ ^[1-9][0-9]*\$ ]] || exit 1
case "\${PH4_CPU_ARCHITECTURE:-}" in
    x86_64|aarch64) ;;
    *) exit 1 ;;
esac
[[ -r "\$FONT_CONF" ]] || {
    printf 'firefox-esr: PH4NTXM font profile is unavailable\\n' >&2
    exit 1
}

USERJS_TEMPLATE="/etc/firefox-esr/mode/\$MODE/user.js"
[[ -r "\$USERJS_TEMPLATE" ]] || exit 1
USERJS_TMP=\$(mktemp "\$PROFILE_DIR/.user.js.XXXXXX")
cleanup_userjs() {
    rm -f -- "\${USERJS_TMP:-}"
}
trap cleanup_userjs EXIT
cp "\$USERJS_TEMPLATE" "\$USERJS_TMP"
sed -i "s|{{DPR}}|\${PH4_DEVICE_PIXEL_RATIO}|g" "\$USERJS_TMP"
sed -i "s|{{CORES}}|\${PH4_REPORTED_CORES}|g" "\$USERJS_TMP"
sed -i "s|{{ARCH}}|\${PH4_CPU_ARCHITECTURE}|g" "\$USERJS_TMP"
sed -i "s|{{FIREFOX_MAJOR}}|\${FIREFOX_MAJOR}|g" "\$USERJS_TMP"
if grep -Eq '\\{\\{[A-Z_][A-Z0-9_]*\\}\\}' "\$USERJS_TMP"; then
    printf 'firefox-esr: unresolved browser identity value\\n' >&2
    exit 1
fi
chmod 0600 "\$USERJS_TMP"
mv -f "\$USERJS_TMP" "\$PROFILE_DIR/user.js"
USERJS_TMP=
trap - EXIT

export FONTCONFIG_PATH="\$FONT_DIR"
export FONTCONFIG_FILE="\$FONT_CONF"

"\$REAL_BROWSER" -profile "\$PROFILE_DIR" --no-remote "\$@"
EOF

chmod +x "$REAL_PATH"
