set -eu

SOURCE=/usr/local/src/ph4ntxm-emergency-password
MODULES=/usr/lib/$(gcc -print-multiarch)/security
HELPER=/usr/local/libexec/ph4ntxm-emergency-check
export DEBIAN_FRONTEND=noninteractive

dpkg-query -W -f='${db:Status-Abbrev}' xfce4-screensaver | grep -q '^ii '
if dpkg-query -W -f='${db:Status-Abbrev}' light-locker 2>/dev/null | grep -q '^ii '; then
    purge_plan=$(LC_ALL=C apt-get --simulate purge --no-auto-remove light-locker)
    for package in $(printf '%s\n' "$purge_plan" | awk '$1 == "Remv" || $1 == "Purg" {print $2}'); do
        case "${package%%:*}" in
            light-locker) ;;
            *)
                printf 'Locker replacement would remove another package: %s\n' "$package" >&2
                exit 1
                ;;
        esac
    done
    apt-get purge -y --no-auto-remove light-locker
fi

install -d -m 0755 "$MODULES" /usr/local/libexec
gcc -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
    -D_FORTIFY_SOURCE=3 -fstack-protector-strong -fPIC -shared \
    "$SOURCE/pam_emergency.c" -lpam -Wl,-z,relro,-z,now \
    -o "$MODULES/pam_ph4ntxm_emergency.so"
gcc -std=c11 -O2 -Wall -Wextra -Werror -Wpedantic \
    -D_FORTIFY_SOURCE=3 -fstack-protector-strong -fPIE \
    "$SOURCE/check.c" -lcrypt -pie -Wl,-z,relro,-z,now -o "$HELPER"
chown root:root "$MODULES/pam_ph4ntxm_emergency.so" "$HELPER"
chmod 0644 "$MODULES/pam_ph4ntxm_emergency.so"
chmod 4755 "$HELPER"
python3 -B -I "$SOURCE/tests/test-session-auth.py" \
    /usr/local/sbin/ph4ntxm-session-password /usr/local/sbin/ph4ntxm-session-status
python3 -B -I "$SOURCE/tests/test-session-setup.py" /usr/local/bin/ph4ntxm-session-setup
python3 -B -I "$SOURCE/tests/test-native.py"
cat >/etc/pam.d/xfce4-screensaver <<'PAM'
auth [success=done default=ignore] pam_unix.so
auth requisite pam_ph4ntxm_emergency.so
auth requisite pam_deny.so
account include common-account
PAM
chmod 0644 /etc/pam.d/xfce4-screensaver
grep -qx 'Exec=xfce4-screensaver' /etc/xdg/autostart/xfce4-screensaver.desktop
test ! -x /usr/bin/light-locker
rm -rf "$SOURCE"
