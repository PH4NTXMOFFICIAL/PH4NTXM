set -eu

SOURCE=/usr/local/src/ph4ntxm-media
RUNTIME=/usr/local/lib/ph4ntxm-media
HELPERS=/usr/local/libexec/ph4ntxm-media
install -d -m 0755 "$RUNTIME" "$HELPERS"
cc -std=c11 -O2 -Wall -Wextra -Werror "$SOURCE/filter.c" -o "$HELPERS/filter"
python3 "$SOURCE/tests/test-media.py" "$HELPERS/filter"
install -m 0644 "$SOURCE/media.py" "$RUNTIME/media.py"
install -m 0755 /usr/bin/bwrap "$HELPERS/bwrap"
ln -sf /usr/bin/Xephyr "$HELPERS/Xephyr"
ln -sf /usr/bin/wmctrl "$HELPERS/wmctrl"
chmod 0755 /usr/local/bin/ph4ntxm-media
rm -rf "$SOURCE"
